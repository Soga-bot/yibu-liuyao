/* pages/divination/divination.wxss — 全屏画布 + 视图浮层（同层渲染画布用普通 view 覆盖） */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #EDE4CF; /* 宣纸浅底，与 renderer 清屏色一致（深底时龟壳铜钱看不清） */
  overflow: hidden;
}

/* 全屏 WebGL 画布 */
.gl {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 加载中提示 */
.status {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  text-align: center;
  color: #a8916e;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  z-index: 5;
}

/* 返回 */
.back {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(62, 39, 35, 0.08);
  color: #6B4A2B;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
  z-index: 5;
}
.back-hover {
  background: rgba(62, 39, 35, 0.18);
}

/* 提示文案（最近一爻结果/引导） */
.tip {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 92rpx);
  left: 0;
  right: 0;
  text-align: center;
  color: #6B5537;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  z-index: 5;
}

/* 爻进度条：左→右 = 初→上 */
.lines {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 140rpx);
  left: 30rpx;
  right: 30rpx;
  display: flex;
  justify-content: center;
  z-index: 5;
}
.line-slot {
  width: 108rpx;
  text-align: center;
}
.line-sym {
  color: #3E2723;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.line-dong {
  color: #C62828; /* 动爻标红（与排盘页一致） */
}
.line-name {
  margin-top: 6rpx;
  color: #a8916e;
  font-size: 20rpx;
}

/* 清零重摇（小按钮，主按钮上方） */
.reset {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 180rpx);
  text-align: center;
  color: #8a5e15;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  z-index: 5;
}
.reset-hover {
  color: #C62828;
}

/* 摇卦按钮（纯色背景稳妥；浮于底部居中） */
.btn {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 70rpx);
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  margin: 0 110rpx;
  border-radius: 46rpx;
  background: #C62828;
  color: #F6D77A;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border: 2rpx solid #E6C158;
  z-index: 5;
}
.btn-hover {
  background: #B11D1D;
}
.btn-disabled {
  opacity: 0.6;
}

/* 问事签：起卦前默祷所求的弹卡（签条风，底部浮入） */
.ask-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(43, 28, 15, 0.35);
  z-index: 8;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ask-card {
  width: 560rpx;
  padding: 48rpx 44rpx 36rpx;
  background: rgba(255, 252, 242, 0.96);
  border: 2rpx solid #E6C158;
  border-radius: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(43, 28, 15, 0.18);
  animation: ask-up 0.3s ease-out;
}
@keyframes ask-up {
  from { transform: translateY(48rpx); opacity: 0; }
  to   { transform: translateY(0);    opacity: 1; }
}
.ask-title {
  text-align: center;
  font-size: 38rpx;
  color: #3E2723;
  letter-spacing: 6rpx;
}
.ask-sub {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}
.ask-row {
  display: flex;
  align-items: center;
  margin: 44rpx 8rpx 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #E6C158;
}
.ask-label {
  font-size: 30rpx;
  color: #6B4A2B;
}
.ask-input {
  flex: 1;
  height: 48rpx;
  font-size: 30rpx;
  color: #3E2723;
}
.ask-ph {
  color: #c9b28a;
}
.ask-btn {
  margin-top: 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #C62828;
  color: #F6D77A;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border: 2rpx solid #E6C158;
}
.ask-btn-hover {
  background: #B11D1D;
}
.ask-skip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}
.ask-skip-hover {
  color: #C62828;
}
