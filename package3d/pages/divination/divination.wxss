/* pages/divination/divination.wxss — 全屏画布 + 视图浮层（同层渲染画布用普通 view 覆盖） */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #EDE4CF; /* 宣纸浅底，与 renderer 清屏色一致（深底时龟壳铜钱看不清） */
  overflow: hidden;
}

/* 全屏 WebGL 画布（显式 z-index：浮层 5/8 压在画布上，防原生层浮动时序问题） */
.gl {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

/* 加载中提示 */
.status {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  transform: translateY(-50%);
  text-align: center;
  color: #a8916e;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  z-index: 5;
}

/* 返回（cover-view 原生层，页面唯一返回键）：仅用其支持的 css 子集（无 border/box-shadow）；
   top 由 JS 按状态栏高度算好内联注入——view 版曾因部分真机 env() 失效顶进状态栏且点击被吞 */
.cback {
  position: fixed;
  left: 24rpx;
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background-color: #FFFAEB;
  color: #5A3E22;
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  line-height: 68rpx;
  z-index: 99;
}

/* 提示文案（最近一爻结果/引导） */
.tip {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 92rpx);
  left: 0;
  right: 0;
  text-align: center;
  color: #6B5537;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  z-index: 5;
}

/* 爻进度条：左→右 = 初→上 */
.lines {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 140rpx);
  left: 30rpx;
  right: 30rpx;
  display: flex;
  justify-content: center;
  z-index: 5;
}
.line-slot {
  width: 108rpx;
  text-align: center;
}
.line-sym {
  color: #3E2723;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 2rpx;
}
.line-dong {
  color: #C62828; /* 动爻标红（与排盘页一致） */
}
.line-name {
  margin-top: 6rpx;
  color: #a8916e;
  font-size: 20rpx;
}
/* 新得之爻弹入：最新一格缩放浮现（旧爻静止，形成「又得一爻」的节奏感） */
.line-slot.pop {
  animation: linePop 0.5s ease-out;
}
@keyframes linePop {
  0% { transform: scale(0.3); opacity: 0; }
  55% { transform: scale(1.22); opacity: 1; }
  100% { transform: scale(1); }
}

/* 摇动中的默念提醒（每爻一现）：主按钮正上方——摇动期「重摇」键隐藏让位，
   同档不叠；呼吸式渐隐渐显引人注目又不刺眼，长所问自动换行 */
.qiu-remind {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(env(safe-area-inset-bottom) + 188rpx);
  text-align: center;
  color: #5A3E22;
  font-size: 26rpx;
  line-height: 1.6;
  letter-spacing: 2rpx;
  z-index: 5;
  animation: qiuBreath 2.4s ease-in-out infinite alternate;
}
@keyframes qiuBreath {
  from { opacity: 0.55; }
  to { opacity: 1; }
}

/* 清零重摇（小按钮，主按钮上方） */
.reset {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 180rpx);
  text-align: center;
  color: #8a5e15;
  font-size: 24rpx;
  letter-spacing: 4rpx;
  z-index: 5;
}
.reset-hover {
  color: #C62828;
}

/* 摇卦按钮（纯色背景稳妥；浮于底部居中） */
.btn {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 70rpx);
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  margin: 0 110rpx;
  border-radius: 46rpx;
  background: #C62828;
  color: #F6D77A;
  font-size: 32rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border: 2rpx solid #E6C158;
  z-index: 5;
}
.btn-hover {
  background: #B11D1D;
}
/* 问事签已拆独立页（package3d/pages/ask）：弹卡曾长期被首进的原生画布层压住
   （同层渲染偶发失效，浮层全被盖），与画布同页无解，故移出本页 */

