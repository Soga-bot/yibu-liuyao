<!-- pages/divination/divination.wxml — 3D 起卦页（全屏画布 + 视图浮层）-->
<!-- canvas type="webgl" 为同层渲染，浮层用普通 view 盖画布；
     另备一枚 cover-view 返回键兜底：同层渲染偶发失效时原生画布浮到所有 view 之上，
     view 版返回键跟着隐没，cover-view 属原生层仍可见（同层正常时它不显示，二者不会同屏） -->
<view class="page">
  <!-- 全屏 WebGL 画布；手势拨动：横向拖动龟壳绕中心 360° 旋转（跟手+惯性），位置不变 -->
  <canvas type="webgl" id="gl" class="gl"
          bindtouchstart="onShellTouchStart" bindtouchmove="onShellTouchMove"
          bindtouchend="onShellTouchEnd" bindtouchcancel="onShellTouchEnd"></canvas>

  <!-- 加载中提示 -->
  <view wx:if="{{loading}}" class="status">{{status}}</view>

  <!-- 返回（视图层版） -->
  <view class="back" hover-class="back-hover" bindtap="onBack">‹</view>

  <!-- 返回（原生层兜底版：仅在同层渲染失效、view 版隐没时可见） -->
  <cover-view class="cback" style="top: {{sbTop}}px" bindtap="onBack">‹</cover-view>

  <!-- 提示文案（最近一爻结果 / 引导） -->
  <view wx:if="{{tip}}" class="tip">{{tip}}</view>

  <!-- 爻进度：左→右 = 初→上，摇一枚亮一格 -->
  <view wx:if="{{lines.length}}" class="lines">
    <view class="line-slot {{item.justSet ? 'pop' : ''}}" wx:for="{{lines}}" wx:key="posName">
      <view class="line-sym {{item.dong ? 'line-dong' : ''}}">{{item.yin ? '━ ━' : '━━━'}}</view>
      <view class="line-name">{{item.posName}}·{{item.name}}</view>
    </view>
  </view>

  <!-- 清零重摇（刻录仪式中藏：别打断转壳刻爻的节拍） -->
  <view
    wx:if="{{lines.length && !shaking && phase !== 'inscribing'}}"
    class="reset"
    hover-class="reset-hover"
    bindtap="onReset"
  >重摇</view>

  <!-- 摇卦按钮：仅待机/摇动/卦成态显示（装钱等仪式阶段隐藏；所求已在问事签独立页问过） -->
  <view
    wx:if="{{!btnHidden}}"
    class="btn {{shaking ? 'btn-disabled' : ''}}"
    hover-class="btn-hover"
    hover-stay-time="80"
    bindtap="onShakeTap"
  >{{btnLabel}}</view>
</view>
