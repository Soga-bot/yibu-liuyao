<!-- pages/divination/divination.wxml — 3D 起卦页（全屏画布 + 视图浮层）-->
<!-- canvas type="webgl" 为同层渲染，浮层用普通 view 即可盖在画布上；
     勿用 cover-view（那是旧版原生组件专用，压同层画布在工具/部分真机上不显示） -->
<view class="page">
  <!-- 全屏 WebGL 画布；手势拨动：横向拖动龟壳绕中心 360° 旋转（跟手+惯性），位置不变 -->
  <canvas type="webgl" id="gl" class="gl"
          bindtouchstart="onShellTouchStart" bindtouchmove="onShellTouchMove"
          bindtouchend="onShellTouchEnd" bindtouchcancel="onShellTouchEnd"></canvas>

  <!-- 加载中提示 -->
  <view wx:if="{{loading}}" class="status">{{status}}</view>

  <!-- 返回 -->
  <view class="back" hover-class="back-hover" bindtap="onBack">‹</view>

  <!-- 提示文案（最近一爻结果 / 引导） -->
  <view wx:if="{{tip}}" class="tip">{{tip}}</view>

  <!-- 爻进度：左→右 = 初→上，摇一枚亮一格 -->
  <view wx:if="{{lines.length}}" class="lines">
    <view class="line-slot" wx:for="{{lines}}" wx:key="posName">
      <view class="line-sym {{item.dong ? 'line-dong' : ''}}">{{item.yin ? '━ ━' : '━━━'}}</view>
      <view class="line-name">{{item.posName}}·{{item.name}}</view>
    </view>
  </view>

  <!-- 清零重摇 -->
  <view
    wx:if="{{lines.length && !shaking}}"
    class="reset"
    hover-class="reset-hover"
    bindtap="onReset"
  >重摇</view>

  <!-- 摇卦按钮：仅待机/摇动/卦成态显示（装钱等仪式阶段隐藏，入口由问事签自动弹出承担） -->
  <view
    wx:if="{{!btnHidden}}"
    class="btn {{shaking ? 'btn-disabled' : ''}}"
    hover-class="btn-hover"
    hover-stay-time="80"
    bindtap="onShakeTap"
  >{{btnLabel}}</view>

  <!-- 问事签：起卦前默祷所求（可不填），为后续解读提供上下文；签条风浮入 -->
  <view wx:if="{{asking}}" class="ask-mask">
    <view class="ask-card">
      <view class="ask-title font-kai">所问何事</view>
      <view class="ask-sub">静心凝神，默祷所求（可不填）</view>
      <view class="ask-row">
        <text class="ask-label font-kai">问：</text>
        <input class="ask-input font-kai" value="{{qiu}}" maxlength="30"
               placeholder="如：事业、访友、出行" placeholder-class="ask-ph"
               bindinput="onQiuInput" confirm-type="done" bindconfirm="onQiuConfirm" />
      </view>
      <view class="ask-btn font-kai" hover-class="ask-btn-hover" bindtap="onQiuConfirm">凝神起卦</view>
      <view class="ask-skip" hover-class="ask-skip-hover" bindtap="onQiuSkip">直接起卦 ›</view>
    </view>
  </view>
</view>
