/* package3d/pages/wenyi/wenyi.wxss — 问易（古朴宣纸风，复用 result 范式）
   类名一律 ASCII（WXSS 编译器不接受中文类选择器），中文只进内容 */
.status-bar { width: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F8F3E9;
  background-image: radial-gradient(circle at 20% 10%, rgba(139,105,20,0.05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, rgba(192,57,43,0.04) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(62,39,35,0.06);
  color: #5D4037; font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: #3E2723;
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

.card {
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(62,39,35,0.08);
}
.card-h {
  text-align: center;
  font-size: 30rpx;
  color: #8a5e15;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed rgba(139,105,20,0.18);
}
.row:last-of-type { border-bottom: none; }
.k { font-size: 25rpx; color: #a8916e; }
.v { font-size: 28rpx; color: #3E2723; }

.note {
  font-size: 25rpx;
  color: #5D4037;
  line-height: 1.8;
}
.note-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #a8916e;
  line-height: 1.7;
}
.lead-btn {
  margin-top: 22rpx;
  background: linear-gradient(135deg, #C62828 0%, #9b1c1c 100%);
  color: #F6D77A; font-size: 30rpx; letter-spacing: 6rpx;
  border-radius: 44rpx; border: 2rpx solid #E6C158;
}
.lead-btn.ghost {
  background: rgba(255,253,246,0.9);
  color: #9b1c1c;
  border: 2rpx solid rgba(198,40,40,0.4);
}
.lead-btn::after { border: none; }
.lead-hover { opacity: 0.85; }

/* 解读生成中：朱金三点依次跳动（同按钮底色，替代干等文案） */
.ask-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  letter-spacing: 6rpx;
}
.ask-dots { display: flex; align-items: flex-end; margin-right: 16rpx; }
.adot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #F6D77A;
  margin: 0 5rpx;
  animation: adot-jump 1s ease-in-out infinite;
}
.adot:nth-child(2) { animation-delay: 0.15s; }
.adot:nth-child(3) { animation-delay: 0.3s; }
@keyframes adot-jump {
  0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
  30% { transform: translateY(-10rpx); opacity: 1; }
}

/* 已存解读 */
.ai-box {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  background: rgba(248,243,233,0.75);
  border: 1rpx solid rgba(139,105,20,0.2);
  border-radius: 12rpx;
}
.ai-meta {
  font-size: 21rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
.ai-text {
  font-size: 26rpx;
  color: #3E2723;
  line-height: 1.8;
}

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8916e;
}
.bottom-pad { height: 40rpx; }
