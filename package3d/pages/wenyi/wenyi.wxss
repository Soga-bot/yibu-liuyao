/* package3d/pages/wenyi/wenyi.wxss — 问易（古朴宣纸风，复用 result 范式）
   类名一律 ASCII（WXSS 编译器不接受中文类选择器），中文只进内容 */
.status-bar { width: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}

/* 栏高不写死：由 .back/.title 的 88rpx 行高撑起（与「我的」标题行同一机制） */
.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.back {
  width: 64rpx;
  height: 88rpx;
  font-size: 52rpx;
  color: var(--text-2);
  line-height: 88rpx;
  text-align: center;
}
.title {
  flex: 1; text-align: center;
  height: 88rpx; line-height: 88rpx;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

.card {
  background: var(--card);
  border: 1rpx solid var(--tint-30);
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow-2);
}
.card-h {
  text-align: center;
  font-size: 30rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--tint-15);
}
.row:last-of-type { border-bottom: none; }
.k { font-size: 25rpx; color: var(--text-weak); }
.v { font-size: 28rpx; color: var(--text); }

.note {
  font-size: 25rpx;
  color: var(--text-2);
  line-height: 1.8;
}
.note-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.7;
}
.lead-btn {
  margin-top: 22rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #F6D77A; font-size: 30rpx; letter-spacing: 6rpx;
  border-radius: 44rpx; border: 2rpx solid #E6C158;
}
.lead-btn.ghost {
  background: var(--wash-card-90);
  color: var(--red-deep);
  border: 2rpx solid var(--rwash-40);
}
.lead-btn::after { border: none; }
.lead-hover { opacity: 0.85; }
/* 模拟态说明行（按钮下方，弱化） */
.mock-tip {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.7;
  text-align: center;
}

/* ---------- 解读生成中：八卦盘等待动画 ----------
   外环先天序卦画径向排布，依次点亮熄灭追逐一圈；整盘缓慢自转；
   中心「易」字呼吸。纯 CSS，无图片依赖。 */
.ask-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 8rpx;
}
.bagua-disc {
  position: relative;
  width: 220rpx; height: 220rpx;
  border: 2rpx solid var(--tint-35);
  border-radius: 50%;
  background: var(--wash-card-70);
  box-shadow: inset 0 0 18rpx var(--tint-10);
}
.disc-rot {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  animation: disc-spin 10s linear infinite;
}
@keyframes disc-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.ring-item {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.ri-0 { transform: rotate(0deg); }
.ri-1 { transform: rotate(45deg); }
.ri-2 { transform: rotate(90deg); }
.ri-3 { transform: rotate(135deg); }
.ri-4 { transform: rotate(180deg); }
.ri-5 { transform: rotate(225deg); }
.ri-6 { transform: rotate(270deg); }
.ri-7 { transform: rotate(315deg); }
.tri {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: tri-chase 1.6s linear infinite;
}
/* 八卦依次点亮：各错开 1/8 周期，形成追逐的光点 */
.ri-0 .tri { animation-delay: 0s; }
.ri-1 .tri { animation-delay: 0.2s; }
.ri-2 .tri { animation-delay: 0.4s; }
.ri-3 .tri { animation-delay: 0.6s; }
.ri-4 .tri { animation-delay: 0.8s; }
.ri-5 .tri { animation-delay: 1s; }
.ri-6 .tri { animation-delay: 1.2s; }
.ri-7 .tri { animation-delay: 1.4s; }
@keyframes tri-chase {
  0%, 18%, 100% { opacity: 0.22; transform: scale(1); }
  8% { opacity: 1; transform: scale(1.18); }
}
.tl {
  width: 30rpx; height: 5rpx;
  border-radius: 2rpx;
  background: var(--text);
}
.tl + .tl { margin-top: 4rpx; }
.tl-yin {
  background: none;
  display: flex;
  justify-content: space-between;
}
.tl-yin .th { width: 12rpx; height: 5rpx; border-radius: 2rpx; background: var(--text); }
.disc-center {
  position: absolute;
  left: 50%; top: 50%;
  width: 76rpx; height: 76rpx;
  margin: -38rpx 0 0 -38rpx;
  border-radius: 50%;
  background: var(--tint-10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: var(--gold);
  animation: center-breathe 1.6s ease-in-out infinite;
}
@keyframes center-breathe {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}
.ask-txt {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
  letter-spacing: 4rpx;
}

/* 已存解读 */
.ai-box {
  margin-bottom: 18rpx;
  padding: 20rpx 22rpx;
  background: var(--wash-bg-75);
  border: 1rpx solid var(--tint-20);
  border-radius: 12rpx;
}
.ai-meta {
  font-size: 21rpx;
  color: var(--text-weak);
  letter-spacing: 2rpx;
  margin-bottom: 10rpx;
}
/* 阅读正文接 --fss 缩放（设置页三档：标准1 / 大1.15 / 特大1.3） */
.ai-text {
  font-size: calc(26rpx * var(--fss, 1));
  color: var(--text);
  line-height: 1.8;
}

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
.bottom-pad { height: 40rpx; }

/* ===== 标题定位（v0.3.8 迁移自五行页定稿）：栏中心 = 6.4vh =====
   校准链：被压顶进状态栏(锚点≈3.8%) → 正中50vh → 5/6 → 11.5vh(偏低) →
   2/3 → 6.4vh（用户确认）。margin 不参与 flex 收缩、栏体禁缩；spacer 藏起
   状态栏双下限保护暂缓（v0.3.9：内联 max() 疑与工具编译冲突先移除，
   后续换 js 计算 px 绑定回归）。 */
.status-bar { display: none; }
.topbar { margin-top: calc(6.4vh - 44rpx); flex-shrink: 0; }
