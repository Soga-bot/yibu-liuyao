/* package3d/pages/wenyi/wenyi.wxss — 问易（古朴宣纸风，复用 result 范式）
   类名一律 ASCII（WXSS 编译器不接受中文类选择器），中文只进内容 */
.status-bar { width: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F8F3E9;
  background-image: radial-gradient(circle at 20% 10%, rgba(139,105,20,0.05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, rgba(192,57,43,0.04) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(62,39,35,0.06);
  color: #5D4037; font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: #3E2723;
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

.card {
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 16rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(62,39,35,0.08);
}
.card-h {
  text-align: center;
  font-size: 30rpx;
  color: #8a5e15;
  font-weight: bold;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx dashed rgba(139,105,20,0.18);
}
.row:last-of-type { border-bottom: none; }
.k { font-size: 25rpx; color: #a8916e; }
.v { font-size: 28rpx; color: #3E2723; }

.note {
  font-size: 25rpx;
  color: #5D4037;
  line-height: 1.8;
}
.note-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #a8916e;
  line-height: 1.7;
}
.lead-btn {
  margin-top: 22rpx;
  background: linear-gradient(135deg, #C62828 0%, #9b1c1c 100%);
  color: #F6D77A; font-size: 30rpx; letter-spacing: 6rpx;
  border-radius: 44rpx; border: 2rpx solid #E6C158;
}
.lead-btn.ghost {
  background: rgba(255,253,246,0.9);
  color: #9b1c1c;
  border: 2rpx solid rgba(198,40,40,0.4);
}
.lead-btn::after { border: none; }
.lead-hover { opacity: 0.85; }

/* ---------- 解读生成中：八卦盘等待动画 ----------
   外环先天序卦画径向排布，依次点亮熄灭追逐一圈；整盘缓慢自转；
   中心「易」字呼吸。纯 CSS，无图片依赖。 */
.ask-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0 8rpx;
}
.bagua-disc {
  position: relative;
  width: 220rpx; height: 220rpx;
  border: 2rpx solid rgba(139,105,20,0.35);
  border-radius: 50%;
  background: rgba(255,253,246,0.65);
  box-shadow: inset 0 0 18rpx rgba(139,105,20,0.08);
}
.disc-rot {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  animation: disc-spin 10s linear infinite;
}
@keyframes disc-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.ring-item {
  position: absolute;
  left: 0; top: 0;
  width: 100%; height: 100%;
  display: flex;
  align-items: flex-start;
  justify-content: center;
}
.ri-0 { transform: rotate(0deg); }
.ri-1 { transform: rotate(45deg); }
.ri-2 { transform: rotate(90deg); }
.ri-3 { transform: rotate(135deg); }
.ri-4 { transform: rotate(180deg); }
.ri-5 { transform: rotate(225deg); }
.ri-6 { transform: rotate(270deg); }
.ri-7 { transform: rotate(315deg); }
.tri {
  margin-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: tri-chase 1.6s linear infinite;
}
/* 八卦依次点亮：各错开 1/8 周期，形成追逐的光点 */
.ri-0 .tri { animation-delay: 0s; }
.ri-1 .tri { animation-delay: 0.2s; }
.ri-2 .tri { animation-delay: 0.4s; }
.ri-3 .tri { animation-delay: 0.6s; }
.ri-4 .tri { animation-delay: 0.8s; }
.ri-5 .tri { animation-delay: 1s; }
.ri-6 .tri { animation-delay: 1.2s; }
.ri-7 .tri { animation-delay: 1.4s; }
@keyframes tri-chase {
  0%, 18%, 100% { opacity: 0.22; transform: scale(1); }
  8% { opacity: 1; transform: scale(1.18); }
}
.tl {
  width: 30rpx; height: 5rpx;
  border-radius: 2rpx;
  background: #3E2723;
}
.tl + .tl { margin-top: 4rpx; }
.tl-yin {
  background: none;
  display: flex;
  justify-content: space-between;
}
.tl-yin .th { width: 12rpx; height: 5rpx; border-radius: 2rpx; background: #3E2723; }
.disc-center {
  position: absolute;
  left: 50%; top: 50%;
  width: 76rpx; height: 76rpx;
  margin: -38rpx 0 0 -38rpx;
  border-radius: 50%;
  background: rgba(139,105,20,0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #8a5e15;
  animation: center-breathe 1.6s ease-in-out infinite;
}
@keyframes center-breathe {
  0%, 100% { opacity: 0.55; }
  50% { opacity: 1; }
}
.ask-txt {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #5D4037;
  letter-spacing: 4rpx;
}

