<!-- package3d/pages/wenyi/wenyi.wxml — 问易（AI 解卦壳页） -->
<view class="page {{themeCls}} {{fontCls}}">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <view class="topbar">
    <view class="back font-kai" bindtap="goBack">‹</view>
    <text class="title font-kai">问易</text>
  </view>

  <scroll-view scroll-y class="content">
    <!-- 本卦概要 -->
    <view class="card">
      <view class="card-h font-kai">所问之卦</view>
      <view class="row">
        <text class="k">所问</text>
        <text class="v font-kai">{{qiu || '（未署所问）'}}</text>
      </view>
      <view class="row">
        <text class="k">本卦</text>
        <text class="v font-kai">{{name}}{{bianName ? ' → ' + bianName : ''}}</text>
      </view>
      <view class="row">
        <text class="k">日干支</text>
        <text class="v font-kai">{{gz}}</text>
      </view>
    </view>

    <!-- AI 解读 -->
    <view class="card">
      <view class="card-h font-kai">问易解读</view>

      <!-- 已存解读（本页生成落库 / 历史回看；模拟态带本地合成标注） -->
      <view wx:if="{{aiText}}" class="ai-box">
        <view class="ai-meta">{{aiMeta}}</view>
        <text class="ai-text">{{aiText}}</text>
      </view>

      <!-- 未开通：预告 + 引导读原文，不做死胡同 -->
      <block wx:if="{{mode === ''}}">
        <view wx:if="{{!aiText}}" class="note">问易服务开通后，此处将呈现结合卦象、爻辞与所问之事的合参文字解读（经云端模型生成，密钥不下发小程序端）。</view>
        <view class="note-sub">当前可先读本卦原文——典籍详情内含卦辞白话、彖象与说卦取象：</view>
        <button class="lead-btn" hover-class="lead-hover" bindtap="onGuaci">读本卦《{{name || '…'}}》</button>
        <button wx:if="{{bianName}}" class="lead-btn ghost" hover-class="lead-hover" bindtap="onBianGuaci">读变卦《{{bianName}}》</button>
      </block>

      <!-- 已开通（模拟/云端）：取读按钮（解读生成后即时落库，历史可回看） -->
      <block wx:else>
        <view wx:if="{{loading}}" class="ask-wrap">
          <view class="bagua-disc">
            <view class="disc-rot">
              <view wx:for="{{ring}}" wx:key="n" class="ring-item ri-{{index}}">
                <view class="tri">
                  <block wx:for="{{item.l}}" wx:for-item="b" wx:key="index">
                    <view wx:if="{{b}}" class="tl"></view>
                    <view wx:else class="tl tl-yin"><view class="th"></view><view class="th"></view></view>
                  </block>
                </view>
              </view>
            </view>
            <view class="disc-center font-kai">易</view>
          </view>
          <view class="ask-txt">解读生成中…</view>
        </view>
        <block wx:else>
          <!-- 未生成：取读入口；已生成：本轮终局，不再提供重问（一事一占） -->
          <block wx:if="{{!aiText}}">
            <button class="lead-btn" hover-class="lead-hover" bindtap="onAsk">开始问易{{mode === 'mock' ? ' · 模拟' : ''}}</button>
            <view wx:if="{{mode === 'mock'}}" class="mock-tip">模拟态：解读由本机排盘与《周易》经文库按固定规则合成，正式版将接入云端模型。</view>
          </block>
          <view wx:else class="done-tip">此卦已解，本轮问易完成。蒙卦辞云「初筮告，再三渎」，一事一占，如需再问请另起一卦。</view>
        </block>
      </block>
    </view>

    <view class="foot-note">问易解读仅供传统文化学习参考 · 不构成任何决策依据</view>
    <view class="bottom-pad"></view>
  </scroll-view>
</view>
