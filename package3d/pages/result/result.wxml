<!-- package3d/pages/result/result.wxml — 摇卦结果（只读，与手动排盘独立） -->
<view class="page {{themeCls}} {{fontCls}}">
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <view class="topbar">
    <view class="back" bindtap="goBack">‹</view>
    <text class="title">卦成</text>
  </view>

  <scroll-view scroll-y class="content">
    <!-- 所问 + 日干支 -->
    <view class="meta-card">
      <view class="meta-row" wx:if="{{qiu}}"><text class="m-label">所问</text><text class="m-val font-kai">问：{{qiu}}</text></view>
      <view class="meta-row"><text class="m-label">起卦</text><text class="m-val">{{replayLabel}} · {{gz}}日</text></view>
    </view>

    <!-- 排盘结果（与手动排盘同观感，只读） -->
    <view wx:if="{{result}}" class="result-card">
      <!-- 有动爻：本卦/变卦并排两框，讲解在下方分列（先本卦后变卦） -->
      <block wx:if="{{bian}}">
        <view class="gua-pair">
          <view class="gua-box">
            <view class="g-label">本 卦</view>
            <view class="g-name font-kai">{{result.name}}</view>
            <view class="gbars">
              <view class="gyao" wx:for="{{ben.yao}}" wx:key="index">
                <view wx:if="{{!item.yin}}" class="gbar yang"></view>
                <view wx:else class="gbar yin"><view class="gseg"></view><view class="gseg"></view></view>
                <text wx:if="{{item.dong}}" class="gmark">{{item.yin ? '✕' : '○'}}</text>
              </view>
            </view>
            <view class="g-meta">{{result.gong}}宫 · {{result.gongWuxing}}</view>
          </view>
          <view class="gua-box">
            <view class="g-label g-label-bian">变 卦</view>
            <view class="g-name font-kai">{{bian.name}}</view>
            <view class="gbars">
              <view class="gyao" wx:for="{{bian.yao}}" wx:key="index">
                <view wx:if="{{!item.yin}}" class="gbar yang"></view>
                <view wx:else class="gbar yin"><view class="gseg"></view><view class="gseg"></view></view>
              </view>
            </view>
            <view class="g-meta">{{bian.gong}}宫 · {{bian.gongWuxing}}</view>
          </view>
        </view>

        <view class="ex-block">
          <view class="ex-title font-kai">本卦 · {{result.nameP}}</view>
          <view wx:if="{{result.desc}}" class="gua-desc">{{result.desc}}</view>
          <view wx:if="{{result.guaci}}" class="gua-guaci font-kai">卦辞：{{result.guaci}}</view>
          <view wx:if="{{result.guaciB}}" class="gua-desc gua-baihua">白话：{{result.guaciB}}</view>
          <view wx:if="{{result.tuan}}" class="gua-daxiang font-kai">彖曰：{{result.tuan}}</view>
          <view wx:if="{{result.daxiang}}" class="gua-daxiang font-kai">象曰：{{result.daxiang}}</view>
        </view>
        <view class="ex-block">
          <view class="ex-title font-kai">变卦 · {{bian.nameP}}</view>
          <view wx:if="{{bian.desc}}" class="gua-desc">{{bian.desc}}</view>
          <view wx:if="{{bian.guaci}}" class="gua-guaci font-kai">卦辞：{{bian.guaci}}</view>
          <view wx:if="{{bian.guaciB}}" class="gua-desc gua-baihua">白话：{{bian.guaciB}}</view>
          <view wx:if="{{bian.tuan}}" class="gua-daxiang font-kai">彖曰：{{bian.tuan}}</view>
          <view wx:if="{{bian.daxiang}}" class="gua-daxiang font-kai">象曰：{{bian.daxiang}}</view>
        </view>
      </block>

      <!-- 无动爻：单卦头 -->
      <view wx:else class="gua-head">
        <view class="gua-name font-kai">{{result.nameP}}卦</view>
        <view class="gua-meta">
          <text>{{result.gong}}宫 · {{result.gongWuxing}}</text>
        </view>
        <view wx:if="{{result.desc}}" class="gua-desc">{{result.desc}}</view>
        <view wx:if="{{result.guaci}}" class="gua-guaci font-kai">卦辞：{{result.guaci}}</view>
        <view wx:if="{{result.guaciB}}" class="gua-desc gua-baihua">白话：{{result.guaciB}}</view>
        <view wx:if="{{result.tuan}}" class="gua-daxiang font-kai">彖曰：{{result.tuan}}</view>
        <view wx:if="{{result.daxiang}}" class="gua-daxiang font-kai">象曰：{{result.daxiang}}</view>
      </view>

      <view class="biao">
        <view class="biao-header">
          <text class="c-ti">爻</text>
          <text class="c-shen">六神</text>
          <text class="c-qin">六亲</text>
          <text class="c-gz">纳甲</text>
          <text class="c-tag">位</text>
          <text class="c-yao">爻象</text>
        </view>
        <block wx:for="{{rows}}" wx:key="posName">
          <view class="biao-row {{item.dong?'is-dong':''}}" data-i="{{index}}" bindtap="toggleCi">
            <text class="c-ti">{{item.ti}}</text>
            <text class="c-shen">{{item.liushen}}</text>
            <text class="c-qin">{{item.liuqin}}</text>
            <text class="c-gz">{{item.gan}}{{item.zhi}}<text class="wx">{{item.wuxing}}</text><text wx:if="{{item.kong}}" class="kong">空</text></text>
            <text class="c-tag tag">{{item.tag}}</text>
            <view class="c-yao">
              <view wx:if="{{!item.yin}}" class="bar yang"></view>
              <view wx:else class="yin"><view class="seg"></view><view class="seg"></view></view>
              <text wx:if="{{item.dong}}" class="ymark">{{item.yin ? '✕' : '○'}}</text>
            </view>
          </view>
          <view wx:if="{{item.showCi && (item.ci || item.xiao || item.ciB)}}" class="row-ci font-kai">{{item.ti}}：{{item.ci}}
            <view wx:if="{{item.xiao}}" class="ci-sub">小象：{{item.xiao}}</view>
            <view wx:if="{{item.ciB}}" class="ci-sub ci-baihua">白话：{{item.ciB}}</view>
          </view>
        </block>
      </view>
      <view class="biao-hint">点爻行可展开/收起爻辞原文</view>

      <view class="kong-line" wx:if="{{result.kongWang.length}}">
        空亡：<text>{{result.kongWang}}</text>
      </view>
      <view class="kong-line">世在第{{result.shi}}爻 · 应在第{{result.ying}}爻</view>
    </view>

    <view wx:if="{{!result}}" class="meta-card">
      <view class="m-val">未取得卦象，请返回重摇</view>
    </view>

    <button class="cast-btn" bindtap="goWenyi">{{wenyiDone ? '回看 · 问易' : '问易 · 合参'}}</button>
    <button class="recast-btn" hover-class="recast-btn-hover" hover-stay-time="60" bindtap="goAsk">重新起卦</button>
    <button class="recast-btn" hover-class="recast-btn-hover" hover-stay-time="60" open-type="share">分享此卦</button>

    <view class="foot-note">本内容仅供传统文化学习参考</view>
    <view class="bottom-pad"></view>
  </scroll-view>

  <!-- 分享卡画布：零尺寸裁剪容器收纳（position:fixed 的屏外画布会诱发同层渲染失效，
       挡住整页触摸——divination 页教训）；导出完成 sharecard.js 置 cardDone 拆节点 -->
  <view class="share-holder">
    <canvas wx:if="{{!cardDone}}" type="2d" id="shareCard" class="share-canvas"></canvas>
  </view>
</view>
