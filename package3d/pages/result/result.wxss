/* package3d/pages/result/result.wxss — 摇卦结果页（观感与手动排盘一致，去录入样式） */
.page {
  min-height: 100vh;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
  display: flex;
  flex-direction: column;
}
.status-bar { width: 100%; }

/* 栏高不写死：由 .back/.title 的 88rpx 行高撑起（与「我的」标题行同一机制） */
.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.back {
  width: 64rpx;
  height: 88rpx;
  font-size: 52rpx;
  color: var(--text-2);
  line-height: 88rpx;
  text-align: center;
}
.title {
  flex: 1; text-align: center;
  height: 88rpx; line-height: 88rpx;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 0 28rpx; box-sizing: border-box; }

/* 所问 / 起卦方式 */
.meta-card {
  background: var(--card);
  border: 1rpx solid var(--tint-25);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx var(--shadow-1);
}
.meta-row {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 8rpx 0;
}
.m-label { font-size: 24rpx; color: var(--text-weak); letter-spacing: 2rpx; }
.m-val { font-size: 28rpx; color: var(--text); letter-spacing: 1rpx; }

/* 主行动点：问易 · AI 解卦；次行动点：重新起卦（降为描边按钮） */
.cast-btn {
  margin: 32rpx 0 8rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #F6D77A; font-size: 34rpx; letter-spacing: 12rpx;
  border-radius: 48rpx; border: 2rpx solid #E6C158;
  box-shadow: 0 6rpx 16rpx var(--rwash-30);
}
.cast-btn::after { border: none; }
.recast-btn {
  margin: 20rpx 0 8rpx;
  background: var(--wash-card-90);
  color: var(--red-deep); font-size: 30rpx; letter-spacing: 8rpx;
  border-radius: 48rpx; border: 2rpx solid var(--rwash-40);
}
.recast-btn::after { border: none; }
.recast-btn-hover { opacity: 0.8; }

/* 结果（与 paipan 一致） */
.result-card {
  background: var(--card);
  border: 1rpx solid var(--tint-30);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-top: 28rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow-2);
}
.gua-head { text-align: center; margin-bottom: 28rpx; }
.gua-name { font-size: 60rpx; color: var(--text); font-weight: bold; letter-spacing: 6rpx; }
.gua-meta { font-size: 26rpx; color: var(--gold); margin-top: 10rpx; letter-spacing: 2rpx; }
.bian { color: var(--red); }
.gua-desc { font-size: calc(24rpx * var(--fss, 1)); color: var(--text-2); margin-top: 12rpx; letter-spacing: 1rpx; }
.gua-daxiang { font-size: calc(26rpx * var(--fss, 1)); color: var(--ink-deep); margin-top: 8rpx; letter-spacing: 2rpx; line-height: 1.5; }
.gua-guaci { font-size: calc(26rpx * var(--fss, 1)); color: var(--text); margin-top: 10rpx; letter-spacing: 2rpx; line-height: 1.6; text-align: center; }
.c-ti { color: var(--gold); font-size: 24rpx; }

.biao {
  display: flex; flex-direction: column;
  border-top: 2rpx solid var(--gold);
  border-bottom: 2rpx solid var(--gold);
}
.biao-header, .biao-row {
  display: grid;
  grid-template-columns: 72rpx 84rpx 84rpx 180rpx 48rpx 1fr;
  align-items: center;
  padding: 14rpx 8rpx;
}
.biao-header {
  border-bottom: 1rpx solid var(--tint-40);
  font-size: 24rpx; color: var(--gold); font-weight: bold;
}
.biao-row {
  border-bottom: 1rpx dashed var(--tint-20);
  font-size: 28rpx; color: var(--text);
}
.biao-row:active { background: var(--tint-10); }
.biao-row:last-child { border-bottom: none; }
.biao-row.is-dong { background: var(--rwash-05); }
.row-ci {
  padding: 14rpx 16rpx 18rpx;
  border-bottom: 1rpx dashed var(--tint-20);
  background: var(--tint-05);
  font-size: calc(26rpx * var(--fss, 1)); color: var(--ink-deep); line-height: 1.7;
}
.biao-hint { margin-top: 10rpx; font-size: 22rpx; color: var(--text-weak); text-align: center; }
.c-shen { color: var(--ink-deep); }
.c-qin { color: var(--text-2); font-weight: bold; }
.c-gz { color: var(--text); }
.c-gz .wx { font-size: 22rpx; color: var(--text-weak); margin-left: 4rpx; }
.c-gz .kong { font-size: 20rpx; color: var(--red); margin-left: 6rpx; border: 1rpx solid var(--red); padding: 0 6rpx; border-radius: 4rpx; }
.c-tag .tag { color: var(--red); font-weight: bold; font-size: 30rpx; }
.c-yao { display: flex; align-items: center; justify-content: center; }
.c-yao .bar.yang { width: 110rpx; height: 12rpx; background: var(--text); border-radius: 2rpx; }
.c-yao .yin { width: 110rpx; height: 12rpx; display: flex; justify-content: space-between; }
.c-yao .yin .seg { width: 44rpx; height: 12rpx; background: var(--text); border-radius: 2rpx; }
.c-yao .ymark { margin-left: 8rpx; color: var(--red); font-size: 24rpx; font-weight: bold; }

.kong-line { margin-top: 18rpx; font-size: 24rpx; color: var(--text-3); letter-spacing: 1rpx; }
.kong-line text { color: var(--red); }

.foot-note {
  margin-top: 28rpx;
  text-align: center; font-size: 22rpx; color: var(--text-weak); letter-spacing: 2rpx;
}
.bottom-pad { height: 60rpx; }

/* 有动爻：本卦/变卦并排两框 */
.gua-pair {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.gua-box {
  flex: 1;
  background: var(--card-2);
  border: 2rpx solid var(--edge);
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}
.g-label {
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 6rpx;
  margin-bottom: 6rpx;
}
.g-label-bian {
  color: var(--red-bian);
}
.g-name {
  font-size: 40rpx;
  color: var(--text);
  margin-bottom: 16rpx;
}
.gbars {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}
.gyao {
  position: relative;
  width: 150rpx;
  height: 13rpx;
  margin: 5rpx 24rpx;
}
.gbar.yang {
  width: 100%;
  height: 100%;
  background: #4A342A;
  border-radius: 7rpx;
}
.gbar.yin {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
}
.gseg {
  width: 42%;
  height: 100%;
  background: #4A342A;
  border-radius: 7rpx;
}
.gmark {
  position: absolute;
  right: -32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: var(--red-bian);
}
.g-meta {
  font-size: 22rpx;
  color: var(--text-3);
}
.ex-block {
  border-top: 2rpx dashed var(--edge);
  padding-top: 18rpx;
  margin-top: 14rpx;
}
.ex-title {
  font-size: 30rpx;
  color: var(--text);
  margin: 10rpx 0 8rpx;
}

/* 白话译句（非楷体，与原文楷体区分）：次级层级——小一号、弱一档、
   缩进一级（原文为主、白话为注，与卦详情页 .baihua 同层级） */
.gua-baihua {
  padding-left: 14rpx;
  font-size: calc(23rpx * var(--fss, 1));
  color: var(--text-3);
}

/* 爻行展开区内的小象/白话（小象为传文原文随 --fss；白话再小一号并缩进） */
.ci-sub {
  margin-top: 8rpx;
  font-size: calc(24rpx * var(--fss, 1));
  color: var(--gold);
  letter-spacing: 1rpx;
}
.ci-baihua {
  padding-left: 14rpx;
  font-size: calc(23rpx * var(--fss, 1));
  color: var(--text-3);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 分享卡隐藏画布：屏外定位（本页无 webgl，无同层渲染冲突；divination 页禁用此法） */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 600px;
  height: 480px;
}

/* ===== 标题定位（v0.3.8 迁移自五行页定稿）：栏中心 = 6.4vh =====
   校准链：被压顶进状态栏(锚点≈3.8%) → 正中50vh → 5/6 → 11.5vh(偏低) →
   2/3 → 6.4vh（用户确认）。margin 不参与 flex 收缩、栏体禁缩；spacer 藏起
   状态栏双下限保护暂缓（v0.3.9：内联 max() 疑与工具编译冲突先移除，
   后续换 js 计算 px 绑定回归）。 */
.status-bar { display: none; }
.topbar { margin-top: calc(6.4vh - 44rpx); flex-shrink: 0; }
