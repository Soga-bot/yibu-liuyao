/* package3d/pages/result/result.wxss — 摇卦结果页（观感与手动排盘一致，去录入样式） */
.page {
  min-height: 100vh;
  background: #F8F3E9;
  background-image: radial-gradient(circle at 20% 10%, rgba(139,105,20,0.05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, rgba(192,57,43,0.04) 0, transparent 160rpx);
  display: flex;
  flex-direction: column;
}
.status-bar { width: 100%; }

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(62,39,35,0.06);
  color: #5D4037; font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: #3E2723;
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 0 28rpx; box-sizing: border-box; }

/* 所问 / 起卦方式 */
.meta-card {
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.25);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx rgba(62,39,35,0.06);
}
.meta-row {
  display: flex; align-items: baseline; justify-content: space-between;
  padding: 8rpx 0;
}
.m-label { font-size: 24rpx; color: #a8916e; letter-spacing: 2rpx; }
.m-val { font-size: 28rpx; color: #3E2723; letter-spacing: 1rpx; }

/* 排盘按钮样式复用为「重新起卦」（主行动点） */
.cast-btn {
  margin: 32rpx 0 8rpx;
  background: linear-gradient(135deg, #C62828 0%, #9b1c1c 100%);
  color: #F6D77A; font-size: 34rpx; letter-spacing: 12rpx;
  border-radius: 48rpx; border: 2rpx solid #E6C158;
  box-shadow: 0 6rpx 16rpx rgba(198,40,40,0.3);
}
.cast-btn::after { border: none; }

/* 结果（与 paipan 一致） */
.result-card {
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-top: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(62,39,35,0.08);
}
.gua-head { text-align: center; margin-bottom: 28rpx; }
.gua-name { font-size: 60rpx; color: #3E2723; font-weight: bold; letter-spacing: 6rpx; }
.gua-meta { font-size: 26rpx; color: #8a5e15; margin-top: 10rpx; letter-spacing: 2rpx; }
.bian { color: #C62828; }
.gua-desc { font-size: 24rpx; color: #5D4037; margin-top: 12rpx; letter-spacing: 1rpx; }
.gua-daxiang { font-size: 26rpx; color: #6d3b0a; margin-top: 8rpx; letter-spacing: 2rpx; line-height: 1.5; }
.gua-guaci { font-size: 26rpx; color: #3E2723; margin-top: 10rpx; letter-spacing: 2rpx; line-height: 1.6; text-align: center; }
.c-ti { color: #8a5e15; font-size: 24rpx; }

.biao {
  display: flex; flex-direction: column;
  border-top: 2rpx solid #8a5e15;
  border-bottom: 2rpx solid #8a5e15;
}
.biao-header, .biao-row {
  display: grid;
  grid-template-columns: 72rpx 84rpx 84rpx 180rpx 48rpx 1fr;
  align-items: center;
  padding: 14rpx 8rpx;
}
.biao-header {
  border-bottom: 1rpx solid rgba(139,105,20,0.4);
  font-size: 24rpx; color: #8a5e15; font-weight: bold;
}
.biao-row {
  border-bottom: 1rpx dashed rgba(139,105,20,0.2);
  font-size: 28rpx; color: #3E2723;
}
.biao-row:active { background: rgba(139,105,20,0.08); }
.biao-row:last-child { border-bottom: none; }
.biao-row.is-dong { background: rgba(198,40,40,0.05); }
.row-ci {
  padding: 14rpx 16rpx 18rpx;
  border-bottom: 1rpx dashed rgba(139,105,20,0.2);
  background: rgba(139,105,20,0.04);
  font-size: 26rpx; color: #6d3b0a; line-height: 1.7;
}
.biao-hint { margin-top: 10rpx; font-size: 22rpx; color: #a8916e; text-align: center; }
.c-shen { color: #6d3b0a; }
.c-qin { color: #5D4037; font-weight: bold; }
.c-gz { color: #3E2723; }
.c-gz .wx { font-size: 22rpx; color: #a8916e; margin-left: 4rpx; }
.c-gz .kong { font-size: 20rpx; color: #C62828; margin-left: 6rpx; border: 1rpx solid #C62828; padding: 0 6rpx; border-radius: 4rpx; }
.c-tag .tag { color: #C62828; font-weight: bold; font-size: 30rpx; }
.c-yao { display: flex; align-items: center; justify-content: center; }
.c-yao .bar.yang { width: 110rpx; height: 12rpx; background: #3E2723; border-radius: 2rpx; }
.c-yao .yin { width: 110rpx; height: 12rpx; display: flex; justify-content: space-between; }
.c-yao .yin .seg { width: 44rpx; height: 12rpx; background: #3E2723; border-radius: 2rpx; }
.c-yao .ymark { margin-left: 8rpx; color: #C62828; font-size: 24rpx; font-weight: bold; }

.kong-line { margin-top: 18rpx; font-size: 24rpx; color: #8a7355; letter-spacing: 1rpx; }
.kong-line text { color: #C62828; }

.foot-note {
  margin-top: 28rpx;
  text-align: center; font-size: 22rpx; color: #a8916e; letter-spacing: 2rpx;
}
.bottom-pad { height: 60rpx; }

/* 有动爻：本卦/变卦并排两框 */
.gua-pair {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.gua-box {
  flex: 1;
  background: #FBF4E4;
  border: 2rpx solid #E0D0AC;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  text-align: center;
}
.g-label {
  font-size: 24rpx;
  color: #8a7355;
  letter-spacing: 6rpx;
  margin-bottom: 6rpx;
}
.g-label-bian {
  color: #B4552D;
}
.g-name {
  font-size: 40rpx;
  color: #3E2723;
  margin-bottom: 16rpx;
}
.gbars {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 16rpx;
}
.gyao {
  position: relative;
  width: 150rpx;
  height: 13rpx;
  margin: 5rpx 24rpx;
}
.gbar.yang {
  width: 100%;
  height: 100%;
  background: #4A342A;
  border-radius: 7rpx;
}
.gbar.yin {
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: space-between;
}
.gseg {
  width: 42%;
  height: 100%;
  background: #4A342A;
  border-radius: 7rpx;
}
.gmark {
  position: absolute;
  right: -32rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 22rpx;
  color: #B4552D;
}
.g-meta {
  font-size: 22rpx;
  color: #8a7355;
}
.ex-block {
  border-top: 2rpx dashed #E0D0AC;
  padding-top: 18rpx;
  margin-top: 14rpx;
}
.ex-title {
  font-size: 30rpx;
  color: #3E2723;
  margin: 10rpx 0 8rpx;
}

/* 白话译句（非楷体，与原文楷体区分） */
.gua-baihua { color: #8a7355; }

/* 爻行展开区内的小象/白话 */
.ci-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a5e15;
  letter-spacing: 1rpx;
}
.ci-baihua {
  color: #5D4037;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
