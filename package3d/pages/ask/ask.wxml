<!-- package3d/pages/ask/ask.wxml — 问事签：起卦前默祷所求 -->
<!-- 独立普通页面（无 canvas）：曾放在 3D 页里做弹卡，首进时原生画布层压住
     WebView 浮层导致弹卡不可见（asking=true 但用户看不到），刷新才恢复——
     根因是同层渲染偶发失效，弹卡与画布同页无解，故拆独立页彻底避开 -->
<view class="page {{themeCls}} {{fontCls}}">
  <!-- 返回 -->
  <view class="back" style="top: calc({{statusBarHeight}}px + 8rpx);" hover-class="back-hover" bindtap="onBack">‹</view>

  <!-- 签条卡 -->
  <view class="ask-card">
    <view class="ask-title font-kai">所问何事</view>
    <view class="ask-sub">静心凝神，默祷所求（可不填）</view>
    <view class="ask-row">
      <text class="ask-label font-kai">问：</text>
      <input class="ask-input font-kai" value="{{qiu}}" maxlength="30"
             placeholder="如：事业、访友、出行" placeholder-class="ask-ph"
             bindinput="onQiuInput" confirm-type="done" />
    </view>
    <view class="ask-btn font-kai" hover-class="ask-btn-hover" bindtap="onQiuConfirm">凝神起卦</view>
    <view class="ask-skip" hover-class="ask-skip-hover" bindtap="onQiuSkip">直接起卦 ›</view>
  </view>

  <!-- 合规提示（审核红线：传统文化定位，可见免责） -->
  <view class="foot">仅供传统文化学习参考</view>
</view>
