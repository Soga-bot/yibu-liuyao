/* package3d/pages/ask/ask.wxss — 问事签独立页（签条风，宣纸底） */
.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #EDE4CF;
  background-image: radial-gradient(circle at 20% 12%, rgba(139,105,20,0.06) 0, transparent 180rpx),
                    radial-gradient(circle at 85% 88%, rgba(192,57,43,0.05) 0, transparent 200rpx);
  overflow: hidden;
}

/* 返回（与 3D 页同款） */
.back {
  position: absolute;
  top: calc(env(safe-area-inset-top) + 16rpx);
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(62, 39, 35, 0.08);
  color: #6B4A2B;
  font-size: 48rpx;
  line-height: 64rpx;
  text-align: center;
  z-index: 5;
}
.back-hover {
  background: rgba(62, 39, 35, 0.18);
}

/* 签条卡（沿用原弹卡样式，浮入动画） */
.ask-card {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 560rpx;
  padding: 48rpx 44rpx 36rpx;
  background: rgba(255, 252, 242, 0.96);
  border: 2rpx solid #E6C158;
  border-radius: 20rpx;
  box-shadow: 0 16rpx 48rpx rgba(43, 28, 15, 0.18);
  animation: ask-up 0.3s ease-out;
}
@keyframes ask-up {
  from { transform: translate(-50%, calc(-50% + 48rpx)); opacity: 0; }
  to   { transform: translate(-50%, -50%);             opacity: 1; }
}
.ask-title {
  text-align: center;
  font-size: 38rpx;
  color: #3E2723;
  letter-spacing: 6rpx;
}
.ask-sub {
  text-align: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}
.ask-row {
  display: flex;
  align-items: center;
  margin: 44rpx 8rpx 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #E6C158;
}
.ask-label {
  font-size: 30rpx;
  color: #6B4A2B;
}
.ask-input {
  flex: 1;
  height: 48rpx;
  font-size: 30rpx;
  color: #3E2723;
}
.ask-ph {
  color: #c9b28a;
}
.ask-btn {
  margin-top: 40rpx;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  border-radius: 42rpx;
  background: #C62828;
  color: #F6D77A;
  font-size: 30rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border: 2rpx solid #E6C158;
}
.ask-btn-hover {
  background: #B11D1D;
}
.ask-skip {
  margin-top: 22rpx;
  text-align: center;
  font-size: 24rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}
.ask-skip-hover {
  color: #C62828;
}

/* 合规提示 */
.foot {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(env(safe-area-inset-bottom) + 40rpx);
  text-align: center;
  font-size: 22rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}
