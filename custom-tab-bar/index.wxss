/* custom-tab-bar/index.wxss */

.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  background-color: var(--tab-bg);
  border-top: 1rpx solid var(--tint-15);
  box-shadow: 0 -2rpx 12rpx var(--shadow-1);
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
}

.tab-text {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--text-3);
}

.tab-text.on {
  color: var(--red);
}

/* 手动主题覆盖（设置页 ly_theme）：变量继承自 page = 跟随系统，
   手动指定时在此重声明本组件消费到的变量（与 app.wxss 同步改）。
   图标已由 .dark 类切深色版，light 态沿用默认（浅色）data-URI。 */
.tab-bar.dark {
  --tab-bg: #201812;
  --tint-15: rgba(201,178,140,0.18);
  --shadow-1: rgba(0,0,0,0.30);
  --text-3: #A08A68;
  --red: #E05545;
}
.tab-bar.light {
  --tab-bg: #fffdf6;
  --tint-15: rgba(139,105,20,0.18);
  --shadow-1: rgba(62,39,35,0.06);
  --text-3: #8a7355;
  --red: #C62828;
}

