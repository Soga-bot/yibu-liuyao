/* pages/settings/settings.wxss — 设置：三态分段选择 + 背景音乐卡（宣纸风） */
.page {
  min-height: 100vh;
  background-color: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
  box-sizing: border-box;
}

/* 固定顶栏：与 detail 页同范式（纯色不透明 + 底边细金线，总高 88rpx） */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  background: var(--bg);
  border-bottom: 1rpx solid var(--tint-30);
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--shadow-1);
  color: var(--text-2); font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { padding: 24rpx 28rpx 60rpx; }

/* ---------- 设置卡 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.card-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.card-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-weak);
  line-height: 1.6;
}

/* ---------- 三态分段选择 ---------- */
.seg {
  display: flex;
  border: 1rpx solid var(--tint-30);
  border-radius: 12rpx;
  overflow: hidden;
}
.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
  padding: 16rpx 0;
  border-left: 1rpx solid var(--tint-15);
  letter-spacing: 2rpx;
}
.seg-item:first-child { border-left: none; }
.seg-hover { background: var(--tint-10); }
.seg-item.on {
  color: #F6D77A;
  background: var(--red);
  font-weight: bold;
}

/* 字号预览行：与阅读正文同缩放基准（--fss） */
.preview {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  background: var(--card-2);
  border: 1rpx dashed var(--tint-30);
  border-radius: 12rpx;
  font-size: calc(26rpx * var(--fss, 1));
  color: var(--text);
  line-height: 1.8;
  letter-spacing: 1rpx;
}

/* ---------- 背景音乐（自「我的」迁入） ---------- */
.bgm-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.bgm-info { flex: 1; min-width: 0; }
.bgm-name {
  display: block;
  font-size: 30rpx;
  color: var(--text);
  letter-spacing: 2rpx;
}
.bgm-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}
.bgm-note {
  flex: 0 0 72rpx;
  width: 72rpx;
  height: 72rpx;
  margin-left: 20rpx;
  border-radius: 50%;
  border: 2rpx solid var(--gold-lt);
  color: var(--text-3);
  font-size: 40rpx;
  line-height: 68rpx;
  text-align: center;
}
.bgm-note.on {
  background: var(--red);
  border-color: var(--red);
  color: #F6D77A;
}
.bgm-note-hover { opacity: 0.7; }

.foot {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
