/* pages/bagong/bagong.wxss — 卦象速查（古朴宣纸风，复用 wuxing/bagua 范式）
   类名一律 ASCII（WXSS 编译器不接受中文类选择器），中文只进内容 */
.status-bar { width: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: var(--shadow-1);
  color: var(--text-2); font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

/* ---------- 卡片 ---------- */
.sec {
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 26rpx 24rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.sec-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.sec-note {
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.7;
}
.intro { padding-bottom: 24rpx; }
.chg-demo { color: var(--red); }

/* ---------- 宫组 ---------- */
.gp-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.gp-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 2rpx;
}
.gp-yy {
  font-size: 21rpx;
  color: var(--text-weak);
  border: 1rpx solid var(--tint-35);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
}
.gp-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

/* ---------- 卦格（4 列 × 2 行） ---------- */
.bcell {
  position: relative;
  width: 24%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 14rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid var(--tint-15);
  border-radius: 10rpx;
  background: var(--wash-bg-60);
}
.bcell-hover {
  background: var(--rwash-05);
  border-color: var(--rwash-40);
}
.btag {
  position: absolute;
  top: 6rpx; left: 8rpx;
  font-size: 19rpx;
  color: rgba(138,94,21,0.65);
}
.blines {
  display: flex;
  flex-direction: column;
  margin-bottom: 10rpx;
}
.bl {
  width: 52rpx; height: 7rpx;
  border-radius: 2rpx;
  background: var(--text);
}
.bl + .bl { margin-top: 7rpx; }
.bl-yin {
  background: none;
  display: flex;
  justify-content: space-between;
}
.bl-yin .bh { width: 22rpx; height: 7rpx; border-radius: 2rpx; background: var(--text); }
/* 变爻红标：相对本宫被变之爻 */
.bl-chg { background: var(--red); }
.bl-yin.bl-chg { background: none; }
.bl-yin.bl-chg .bh { background: var(--red); }
.bname {
  font-size: 22rpx;
  color: var(--text);
  letter-spacing: 1rpx;
}

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
.bottom-pad { height: 40rpx; }
