/* pages/wuxing/wuxing.wxss — 五行基础（古朴宣纸风，复用 detail 范式） */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 8rpx;
}
.back {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--shadow-1);
  color: var(--text-2); font-size: 38rpx; line-height: 56rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 56rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

/* ---------- 卡片 ---------- */
.sec {
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.sec-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.sec-note {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.7;
}
.m-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--tint-15);
}
.m-row:last-of-type { border-bottom: none; }
.m-k { font-size: 28rpx; color: var(--red); font-weight: bold; letter-spacing: 2rpx; }
.m-v { font-size: 25rpx; color: var(--text-2); }

/* ---------- 生克图 ---------- */
.wx-map {
  position: relative;
  width: 480rpx;
  height: 500rpx;
  margin: 0 auto;
}
.lk {
  position: absolute;
  transform-origin: 0 50%;
  z-index: 1;
}
.lk-sheng { height: 3rpx; background: rgba(138,94,21,0.55); border-radius: 2rpx; }
.lk-ke { height: 0; border-top: 3rpx dashed var(--rwash-60); }
.wx-node {
  position: absolute;
  width: 96rpx; height: 96rpx;
  margin-left: -48rpx; margin-top: -48rpx;
  border-radius: 50%;
  color: #fffdf6;
  font-size: 40rpx;
  text-align: center;
  line-height: 96rpx;
  z-index: 2;
  box-shadow: 0 4rpx 10rpx var(--shadow-3);
}
/* 类名用 ASCII（mu/huo/tu/jin/shui），中文类选择器 WXSS 编译不过 */
.n-mu { background: #4E7A3A; }
.n-huo { background: #B4552D; }
.n-tu { background: #8D6E3F; }
.n-jin { background: #A08850; }
.n-shui { background: #3D5A80; }
.map-legend {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  letter-spacing: 2rpx;
}

/* ---------- 归类表 ---------- */
.grid-head, .grid-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 8rpx;
}
.grid-head {
  color: var(--text-3);
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--tint-20);
}
.grid-row { border-bottom: 1rpx dashed var(--tint-15); }
.grid-row:last-of-type { border-bottom: none; }
.gh, .gc {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.gc-x { color: var(--red); font-weight: bold; }

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
.bottom-pad { height: 40rpx; }
