/* pages/wuxing/wuxing.wxss — 五行基础（古朴宣纸风，复用 detail 范式） */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F8F3E9;
  background-image: radial-gradient(circle at 20% 10%, rgba(139,105,20,0.05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, rgba(192,57,43,0.04) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 8rpx;
}
.back {
  width: 64rpx; height: 64rpx;
  border-radius: 50%;
  background: rgba(62,39,35,0.06);
  color: #5D4037; font-size: 48rpx; line-height: 60rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: #3E2723;
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

/* ---------- 卡片 ---------- */
.sec {
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.22);
  border-radius: 16rpx;
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 12rpx rgba(62,39,35,0.05);
}
.sec-title {
  font-size: 28rpx;
  color: #8a5e15;
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.sec-note {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: #a8916e;
  line-height: 1.7;
}
.m-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed rgba(139,105,20,0.18);
}
.m-row:last-of-type { border-bottom: none; }
.m-k { font-size: 28rpx; color: #C62828; font-weight: bold; letter-spacing: 2rpx; }
.m-v { font-size: 25rpx; color: #5D4037; }

/* ---------- 生克图 ---------- */
.wx-map {
  position: relative;
  width: 480rpx;
  height: 500rpx;
  margin: 0 auto;
}
.lk {
  position: absolute;
  transform-origin: 0 50%;
  z-index: 1;
}
.lk-sheng { height: 3rpx; background: rgba(138,94,21,0.55); border-radius: 2rpx; }
.lk-ke { height: 0; border-top: 3rpx dashed rgba(198,40,40,0.6); }
.wx-node {
  position: absolute;
  width: 96rpx; height: 96rpx;
  margin-left: -48rpx; margin-top: -48rpx;
  border-radius: 50%;
  color: #fffdf6;
  font-size: 40rpx;
  text-align: center;
  line-height: 96rpx;
  z-index: 2;
  box-shadow: 0 4rpx 10rpx rgba(62,39,35,0.18);
}
.n-木 { background: #4E7A3A; }
.n-火 { background: #B4552D; }
.n-土 { background: #8D6E3F; }
.n-金 { background: #A08850; }
.n-水 { background: #3D5A80; }
.map-legend {
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8916e;
  letter-spacing: 2rpx;
}

/* ---------- 归类表 ---------- */
.grid-head, .grid-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 8rpx;
}
.grid-head {
  color: #8a7355;
  font-size: 24rpx;
  border-bottom: 1rpx solid rgba(139,105,20,0.22);
}
.grid-row { border-bottom: 1rpx dashed rgba(139,105,20,0.18); }
.grid-row:last-of-type { border-bottom: none; }
.gh, .gc {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #5D4037;
}
.gc-x { color: #C62828; font-weight: bold; }

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8916e;
}
.bottom-pad { height: 40rpx; }
