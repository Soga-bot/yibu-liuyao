/* pages/dianji/shiyi.wxss — 十翼通读页（样式对齐 detail 页） */
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--card) 0%, var(--card-2) 100%);
}
/* 固定顶栏：纯色不透明（与页首渐变同色）+ 底边细金线，正文从顶栏底下过 */
.topbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  background: var(--card);
  border-bottom: 1rpx solid var(--tint-30);
}
.back {
  width: 64rpx;
  height: 88rpx;
  font-size: 52rpx;
  color: var(--text-2);
  line-height: 88rpx;
  text-align: center;
}
.title {
  flex: 1;
  text-align: center;
  height: 88rpx; line-height: 88rpx;
  font-size: 34rpx;
  color: var(--text);
  margin-right: 64rpx;
}
.content {
  padding: 10rpx 30rpx 60rpx;
}
.book-name {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: 38rpx;
  color: var(--text-2);
  letter-spacing: 6rpx;
}
.sec {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--wash-card-70);
  border-radius: 16rpx;
}
.sec-title {
  font-size: 26rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
/* 阅读正文接 --fss 缩放（设置页三档：标准1 / 大1.15 / 特大1.3） */
.daxiang {
  font-size: calc(28rpx * var(--fss, 1));
  color: var(--text-4);
  line-height: 1.9;
  letter-spacing: 2rpx;
}
/* 逐句对照（v0.3.20）：原句楷体同 .daxiang 基准为「主」；译句为「注」——
   小一号、弱一档、整块缩进挂在原句之下（与卦详情页 .baihua 同层级），
   句对之间留呼吸感分组 */
.duiju {
  margin-bottom: 24rpx;
}
.dj-y {
  font-size: calc(28rpx * var(--fss, 1));
  color: var(--text-4);
  line-height: 1.9;
  letter-spacing: 2rpx;
}
.dj-b {
  margin-top: 6rpx;
  padding-left: 14rpx;
  font-size: calc(24rpx * var(--fss, 1));
  color: var(--text-3);
  line-height: 1.7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
/* 章旨提要（非楷体，与原文楷体区分；仅供阅读辅助） */
.zhangzhi {
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  background: rgba(138, 94, 21, 0.06);
  border-left: 6rpx solid var(--gold-lt);
  border-radius: 8rpx;
  font-size: calc(24rpx * var(--fss, 1));
  color: var(--text-5);
  line-height: 1.7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
.src-note {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
