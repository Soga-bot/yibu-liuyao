/* pages/dianji/shiyi.wxss — 十翼通读页（样式对齐 detail 页） */
.status-bar { width: 100%; }
.page {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--card) 0%, var(--card-2) 100%);
}
.topbar {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 30rpx;
}
.back {
  width: 80rpx;
  font-size: 60rpx;
  color: var(--text-2);
  line-height: 1;
}
.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  color: var(--text);
  margin-right: 80rpx;
}
.content {
  padding: 10rpx 30rpx 60rpx;
}
.book-name {
  margin: 40rpx 0 20rpx;
  text-align: center;
  font-size: 38rpx;
  color: var(--text-2);
  letter-spacing: 6rpx;
}
.sec {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--wash-card-70);
  border-radius: 16rpx;
}
.sec-title {
  font-size: 26rpx;
  color: var(--gold);
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}
.daxiang {
  font-size: 28rpx;
  color: var(--text-4);
  line-height: 1.9;
  letter-spacing: 2rpx;
}
/* 章旨提要（非楷体，与原文楷体区分；仅供阅读辅助） */
.zhangzhi {
  margin-bottom: 14rpx;
  padding: 12rpx 18rpx;
  background: rgba(138, 94, 21, 0.06);
  border-left: 6rpx solid var(--gold-lt);
  border-radius: 8rpx;
  font-size: 24rpx;
  color: var(--text-5);
  line-height: 1.7;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}
.src-note {
  margin-top: 30rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
