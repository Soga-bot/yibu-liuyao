<!-- pages/dianji/shiyi.wxml — 十翼通读：系辞上/下、说卦传 -->
<view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
<view class="page">
  <view class="topbar">
    <view class="back font-kai" bindtap="goBack">‹</view>
    <text class="title font-kai">十翼 · 通读</text>
  </view>

  <view class="content">
    <block wx:for="{{books}}" wx:for-item="book" wx:key="name">
      <view class="book-name font-kai">{{book.name}}</view>
      <view class="sec" wx:for="{{book.chapters}}" wx:for-item="c" wx:key="h">
        <view class="sec-title font-kai">第{{c.h}}章</view>
        <view class="daxiang font-kai">{{c.t}}</view>
      </view>
    </block>

    <view class="src-note">原文出自《周易》十翼 · 生僻字随文括注拼音 · 凭通行本录入，校对中</view>
  </view>
</view>
