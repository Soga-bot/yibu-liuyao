<!-- pages/dianji/detail.wxml — 卦详情 -->
<!-- 固定顶栏（带返回）：长正文页滚动钻不进状态栏底下；主题/字号类挂根节点 -->
<view class="topbar {{themeCls}} {{fontCls}}" style="padding-top: calc({{statusBarHeight}}px + 16rpx);">
  <view class="back font-kai" bindtap="goBack">‹</view>
  <text class="title font-kai">{{gua ? gua.name + '卦' : '卦详情'}}</text>
</view>
<view class="page {{themeCls}} {{fontCls}}" style="padding-top: calc({{statusBarHeight}}px + 88rpx);">

  <view class="content" wx:if="{{gua}}">
    <!-- 卦首：大卦象 + 卦名 -->
    <view class="hero">
      <view class="gx-lg">
        <block wx:for="{{gua.xiang}}" wx:for-item="b" wx:key="*this">
          <view wx:if="{{b}}" class="l-yang"></view>
          <view wx:else class="l-yin"><view class="s"></view><view class="s"></view></view>
        </block>
      </view>
      <view class="hero-name font-kai">{{gua.nameP}}</view>
      <view class="hero-desc">{{gua.desc}}</view>
    </view>

    <!-- 卦宫 / 上下卦 -->
    <view class="meta-card">
      <view class="m-row" wx:for="{{gua.meta}}" wx:key="k">
        <text class="m-k">{{item.k}}</text>
        <text class="m-v font-kai">{{item.v}}</text>
      </view>
    </view>

    <!-- 卦辞 + 白话 + 典故 -->
    <view class="sec">
      <view class="sec-title font-kai">卦辞</view>
      <view class="guaci font-kai">{{gua.guaci}}</view>
      <view wx:if="{{gua.guaciB}}" class="baihua">白话：{{gua.guaciB}}</view>
      <view wx:if="{{gua.dg}}" class="diangu">
        <view class="dg-h font-kai">典故</view>
        <view class="dg-b">{{gua.dg.gu}}</view>
        <view class="dg-s">来源：{{gua.dg.lai}}</view>
      </view>
    </view>

    <!-- 彖传（释卦辞） -->
    <view class="sec" wx:if="{{gua.tuan}}">
      <view class="sec-title font-kai">彖传</view>
      <view class="daxiang font-kai">{{gua.tuan}}</view>
      <view wx:if="{{gua.tuanB}}" class="baihua">白话：{{gua.tuanB}}</view>
      <view wx:if="{{gua.tuanDg}}" class="diangu">
        <view class="dg-h font-kai">典故</view>
        <view class="dg-b">{{gua.tuanDg.gu}}</view>
        <view class="dg-s">来源：{{gua.tuanDg.lai}}</view>
      </view>
    </view>

    <!-- 爻辞（初→上）+ 小象 + 用九用六 -->
    <view class="sec">
      <view class="sec-title font-kai">爻辞 · 小象</view>
      <view class="yao-row" wx:for="{{gua.yaoci}}" wx:key="ti">
        <text class="y-ti font-kai">{{item.ti}}</text>
        <view class="y-ci font-kai">{{item.ci}}
          <view wx:if="{{item.ciB}}" class="y-sub y-baihua">白话：{{item.ciB}}</view>
          <view wx:if="{{item.xiao}}" class="y-sub">小象：{{item.xiao}}</view>
          <view wx:if="{{item.xiaoB}}" class="y-sub y-baihua">白话：{{item.xiaoB}}</view>
          <view wx:if="{{item.dg}}" class="diangu">
            <view class="dg-h font-kai">典故</view>
            <view class="dg-b">{{item.dg.gu}}</view>
            <view class="dg-s">来源：{{item.dg.lai}}</view>
          </view>
        </view>
      </view>
      <view class="yao-row" wx:if="{{gua.yong}}">
        <text class="y-ti font-kai">{{gua.yong.ti}}</text>
        <view class="y-ci font-kai">{{gua.yong.ci}}
          <view wx:if="{{gua.yong.xyong}}" class="y-sub">小象：{{gua.yong.xyong}}</view>
          <view wx:if="{{gua.yong.yongB}}" class="y-sub y-baihua">白话：{{gua.yong.yongB}}</view>
        </view>
      </view>
    </view>

    <!-- 大象传 -->
    <view class="sec">
      <view class="sec-title font-kai">象传 · 大象</view>
      <view class="daxiang font-kai">{{gua.daxiang}}</view>
      <view wx:if="{{gua.daxiangB}}" class="baihua">白话：{{gua.daxiangB}}</view>
    </view>

    <!-- 文言传（仅乾坤） -->
    <view class="sec" wx:if="{{gua.wy.length}}">
      <view class="sec-title font-kai">文言传</view>
      <view class="daxiang font-kai wenyan-p" wx:for="{{gua.wy}}" wx:key="index">{{item}}</view>
    </view>

    <!-- 说卦传 · 取象（上下卦） -->
    <view class="sec" wx:if="{{gua.sg.length}}">
      <view class="sec-title font-kai">说卦传 · 取象</view>
      <block wx:for="{{gua.sg}}" wx:for-item="t" wx:key="name">
        <view class="sx-name font-kai">{{t.tag}}卦 · {{t.name}}</view>
        <view class="sx-line font-kai">{{t.xing}}；{{t.shou}}；{{t.shen}}；{{t.qin}}。</view>
        <view class="sx-guang font-kai">{{t.guang}}</view>
      </block>
    </view>

    <!-- 序卦传（卦序由来） -->
    <view class="sec" wx:if="{{gua.xu}}">
      <view class="sec-title font-kai">序卦传</view>
      <view class="daxiang font-kai">{{gua.xu}}</view>
    </view>

    <!-- 杂卦传（卦义对举） -->
    <view class="sec" wx:if="{{gua.za}}">
      <view class="sec-title font-kai">杂卦传</view>
      <view class="daxiang font-kai">{{gua.za}}</view>
    </view>

    <view class="src-note">原文出自《周易》经传 · 生僻字随文括注拼音 · 白话与典故仅供阅读参考</view>
    <view class="src-note" style="margin-top: 8rpx;">白话术语译例：贞——利贞译「守正」、名词译「正固」、动词译「固守」；咎译「咎害」</view>
  </view>

  <!-- 参数异常兜底 -->
  <view wx:else class="empty font-kai">
    <text class="empty-glyph">易</text>
    <text class="empty-tip">未找到该卦</text>
    <text class="empty-sub">请从典籍库列表重新进入</text>
  </view>

  <!-- 分享卡隐藏画布：屏外定位（display:none 取不到 2d 节点，须真实布局） -->
  <canvas type="2d" id="shareCard" class="share-canvas"></canvas>
</view>
