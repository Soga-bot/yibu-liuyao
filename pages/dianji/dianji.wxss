/* pages/dianji/dianji.wxss — 典籍库：64 卦列表 */
.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background-color: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}
.nav-title {
  text-align: center;
  font-size: 40rpx;
  color: var(--text);
  font-weight: bold;
  letter-spacing: 6rpx;
  padding: 50rpx 0 10rpx;
}
.content { padding: 20rpx 28rpx 0; }

/* ---------- 搜索 ---------- */
.search-box {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--tint-30);
  border-radius: 40rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 2rpx 10rpx var(--shadow-1);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text);
}
.search-ph { color: var(--text-weak); }
.search-count {
  font-size: 22rpx;
  color: var(--text-weak);
  margin-left: 20rpx;
}

/* ---------- 十翼通读入口 ---------- */
.shiyi-entry {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-left: 6rpx solid var(--gold-lt);
  border-radius: 16rpx;
  padding: 20rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.shiyi-glyph {
  flex: 0 0 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--gold);
  background: var(--tint-15);
  border-radius: 12rpx;
}
.shiyi-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.shiyi-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text);
  letter-spacing: 3rpx;
}
.shiyi-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ---------- 卦列表 ---------- */
.gua-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.card-hover { background: var(--card-2); }

/* 小卦象：6 爻线（上→下） */
.gx {
  flex: 0 0 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gx .l-yang { width: 56rpx; height: 7rpx; background: var(--text); border-radius: 2rpx; }
.gx .l-yin { width: 56rpx; height: 7rpx; display: flex; justify-content: space-between; }
.gx .l-yin .s { width: 24rpx; height: 7rpx; background: var(--text); border-radius: 2rpx; }
.gx .l-yang + .l-yang, .gx .l-yang + .l-yin,
.gx .l-yin + .l-yang, .gx .l-yin + .l-yin { margin-top: 7rpx; }

.gua-info { flex: 1; margin-left: 26rpx; min-width: 0; }
.g-name-row { display: flex; align-items: baseline; }
.g-name { font-size: 34rpx; color: var(--text); font-weight: bold; letter-spacing: 3rpx; }
.g-badge {
  font-size: 21rpx;
  color: var(--gold);
  border: 1rpx solid var(--tint-40);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.g-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.g-arrow { color: var(--text-weak); font-size: 36rpx; margin-left: 12rpx; }

/* ---------- 空态 ---------- */
.empty {
  margin-top: 140rpx;
  text-align: center;
  color: var(--text-weak);
}
.empty-glyph {
  display: block;
  font-size: 120rpx;
  color: #b07d22;
}
.empty-tip {
  display: block;
  margin-top: 30rpx;
  font-size: 32rpx;
  color: var(--text-2);
}
.empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
}
