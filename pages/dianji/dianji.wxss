/* pages/dianji/dianji.wxss — 典籍库：64 卦列表 */
.page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background-color: #F8F3E9;
  background-image: radial-gradient(circle at 20% 10%, rgba(139,105,20,0.05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, rgba(192,57,43,0.04) 0, transparent 160rpx);
}
.nav-title {
  text-align: center;
  font-size: 40rpx;
  color: #3E2723;
  font-weight: bold;
  letter-spacing: 6rpx;
  padding: 50rpx 0 10rpx;
}
.content { padding: 20rpx 28rpx 0; }

/* ---------- 搜索 ---------- */
.search-box {
  display: flex;
  align-items: center;
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.3);
  border-radius: 40rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(62,39,35,0.05);
}
.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #3E2723;
}
.search-ph { color: #b7a483; }
.search-count {
  font-size: 22rpx;
  color: #a8916e;
  margin-left: 20rpx;
}

/* ---------- 十翼通读入口 ---------- */
.shiyi-entry {
  display: flex;
  align-items: center;
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.22);
  border-left: 6rpx solid #c9a86a;
  border-radius: 16rpx;
  padding: 20rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 3rpx 12rpx rgba(62,39,35,0.05);
}
.shiyi-glyph {
  flex: 0 0 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 40rpx;
  color: #8a5e15;
  background: rgba(201,168,106,0.14);
  border-radius: 12rpx;
}
.shiyi-info { flex: 1; margin-left: 24rpx; min-width: 0; }
.shiyi-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #3E2723;
  letter-spacing: 3rpx;
}
.shiyi-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8a7355;
  letter-spacing: 1rpx;
}

/* ---------- 卦列表 ---------- */
.gua-card {
  display: flex;
  align-items: center;
  background: #fffaf0;
  border: 1rpx solid rgba(139,105,20,0.22);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 3rpx 12rpx rgba(62,39,35,0.05);
}
.card-hover { background: #fdf6e7; }

/* 小卦象：6 爻线（上→下） */
.gx {
  flex: 0 0 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gx .l-yang { width: 56rpx; height: 7rpx; background: #3E2723; border-radius: 2rpx; }
.gx .l-yin { width: 56rpx; height: 7rpx; display: flex; justify-content: space-between; }
.gx .l-yin .s { width: 24rpx; height: 7rpx; background: #3E2723; border-radius: 2rpx; }
.gx .l-yang + .l-yang, .gx .l-yang + .l-yin,
.gx .l-yin + .l-yang, .gx .l-yin + .l-yin { margin-top: 7rpx; }

.gua-info { flex: 1; margin-left: 26rpx; min-width: 0; }
.g-name-row { display: flex; align-items: baseline; }
.g-name { font-size: 34rpx; color: #3E2723; font-weight: bold; letter-spacing: 3rpx; }
.g-badge {
  font-size: 21rpx;
  color: #8a5e15;
  border: 1rpx solid rgba(139,105,20,0.4);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.g-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a7355;
  letter-spacing: 1rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.g-arrow { color: #a8916e; font-size: 36rpx; margin-left: 12rpx; }

/* ---------- 空态 ---------- */
.empty {
  margin-top: 140rpx;
  text-align: center;
  color: #a8916e;
}
.empty-glyph {
  display: block;
  font-size: 120rpx;
  color: #b07d22;
}
.empty-tip {
  display: block;
  margin-top: 30rpx;
  font-size: 32rpx;
  color: #5D4037;
}
.empty-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
}
