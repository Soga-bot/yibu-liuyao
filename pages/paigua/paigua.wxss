/* pages/paigua/paigua.wxss — 解卦：术语速查 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}
/* 顶栏在文档流内（非 fixed）：内容在 scroll-view 里滚，物理上不可能钻到顶栏底下 */
.topbar {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--tint-30);
}
.topbar-title {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--text);
  font-weight: bold;
  letter-spacing: 6rpx;
}
.content { flex: 1; padding: 24rpx 28rpx 140rpx; box-sizing: border-box; }

/* ---------- 起卦入口 ---------- */
.quick-row { display: flex; margin-bottom: 28rpx; }
.quick-card {
  flex: 1;
  border-radius: 16rpx;
  padding: 26rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 4rpx 14rpx var(--shadow-2);
}
.quick-card + .quick-card { margin-left: 24rpx; }
.qc-shake {
  background: linear-gradient(135deg, #D8413A 0%, #B11D1D 100%);
  border: 2rpx solid #E6C158;
}
.qc-shake .qc-name { color: #F6D77A; }
.qc-shake .qc-sub { color: rgba(246,215,122,0.75); }
.qc-manual {
  background: linear-gradient(135deg, #F2B73C 0%, #E0920E 100%);
  border: 2rpx solid var(--gold);
}
.qc-manual .qc-name { color: var(--text-2); }
.qc-manual .qc-sub { color: var(--text-2); }
.qc-name { font-size: 32rpx; font-weight: bold; letter-spacing: 3rpx; }
.qc-sub { font-size: 22rpx; margin-top: 10rpx; letter-spacing: 1rpx; }
.card-hover { opacity: 0.85; transform: scale(0.98); }

/* ---------- 知识卡 ---------- */
.card {
  background: var(--card);
  border: 1rpx solid var(--tint-25);
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx var(--shadow-1);
}
.card-head { display: flex; align-items: center; justify-content: space-between; }
.card-title {
  font-size: 30rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
}
.card-arrow {
  color: var(--text-weak);
  font-size: 36rpx;
  transform: rotate(90deg);
  transition: transform 0.15s ease;
}
.card-arrow.open { transform: rotate(-90deg); }

.k-row {
  display: flex;
  padding: 18rpx 0;
  border-bottom: 1rpx dashed var(--tint-15);
}
.k-row:last-of-type { border-bottom: none; }
.k-k {
  flex: 0 0 172rpx;
  font-size: 27rpx;
  color: var(--red);
  font-weight: bold;
  letter-spacing: 2rpx;
}
.k-v {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.65;
}
.k-note {
  margin-top: 6rpx;
  padding: 16rpx 18rpx;
  background: var(--tint-05);
  border-radius: 10rpx;
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.7;
}
