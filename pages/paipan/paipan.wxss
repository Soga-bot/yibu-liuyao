/* pages/paipan/paipan.wxss — 手动排盘页（古朴宣纸风） */
.page {
  min-height: 100vh;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
  display: flex;
  flex-direction: column;
}
.status-bar { width: 100%; }

/* 栏高不写死：由 .back/.title 的 88rpx 行高撑起（与「我的」标题行同一机制） */
.topbar {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.back {
  width: 64rpx;
  height: 88rpx;
  font-size: 52rpx;
  color: var(--text-2);
  line-height: 88rpx;
  text-align: center;
}
.title {
  flex: 1; text-align: center;
  height: 88rpx; line-height: 88rpx;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 64rpx;
}

.content { flex: 1; padding: 0 28rpx; box-sizing: border-box; }

.card {
  background: var(--card);
  border: 1rpx solid var(--tint-25);
  border-radius: 16rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 4rpx 14rpx var(--shadow-1);
}
.card-title {
  font-size: 28rpx; color: var(--gold); font-weight: bold;
  letter-spacing: 2rpx; margin-bottom: 20rpx;
}

/* 爻录入 */
.yao-list { display: flex; flex-direction: column; }
.yao-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14rpx 0; border-bottom: 1rpx dashed var(--tint-15);
}
.yao-row:last-child { border-bottom: none; }
.pos { width: 80rpx; color: var(--text-2); font-size: 28rpx; }
.yao-sym {
  flex: 1; display: flex; align-items: center; justify-content: center;
  position: relative; padding: 6rpx 0;
}
.bar.yang { width: 200rpx; height: 14rpx; background: var(--text); border-radius: 2rpx; }
.yin { width: 200rpx; height: 14rpx; display: flex; justify-content: space-between; }
.yin .seg { width: 84rpx; height: 14rpx; background: var(--text); border-radius: 2rpx; }
.yao-sym.dong .bar.yang, .yao-sym.dong .yin .seg { background: var(--red); }
.dong-mark {
  position: absolute; right: 60rpx;
  color: var(--red); font-size: 28rpx; font-weight: bold;
}
.dong-btn {
  width: 84rpx; text-align: center;
  border: 1rpx solid var(--tint-40);
  border-radius: 30rpx; padding: 6rpx 0;
  color: var(--text-3); font-size: 24rpx;
}
.dong-btn.on { background: var(--red); color: #fff; border-color: var(--red); }
.hint { margin-top: 14rpx; font-size: 22rpx; color: var(--text-weak); }

/* 日干支 */
.row { display: flex; align-items: center; justify-content: space-between; }
.label { font-size: 28rpx; color: var(--text-2); }
.picker-val { font-size: 30rpx; color: var(--gold); font-weight: bold; }

/* 排盘按钮 */
.cast-btn {
  margin: 32rpx 0 8rpx;
  background: linear-gradient(135deg, var(--red) 0%, var(--red-deep) 100%);
  color: #F6D77A; font-size: 34rpx; letter-spacing: 12rpx;
  border-radius: 48rpx; border: 2rpx solid #E6C158;
  box-shadow: 0 6rpx 16rpx var(--rwash-30);
}
.cast-btn::after { border: none; }

/* 结果 */
.result-card {
  background: var(--card);
  border: 1rpx solid var(--tint-30);
  border-radius: 16rpx;
  padding: 32rpx 28rpx;
  margin-top: 28rpx;
  box-shadow: 0 6rpx 18rpx var(--shadow-2);
}
.gua-head { text-align: center; margin-bottom: 28rpx; }
.gua-name { font-size: 60rpx; color: var(--text); font-weight: bold; letter-spacing: 6rpx; }
.gua-meta { font-size: 26rpx; color: var(--gold); margin-top: 10rpx; letter-spacing: 2rpx; }
.bian { color: var(--red); }
.gua-desc { font-size: 24rpx; color: var(--text-2); margin-top: 12rpx; letter-spacing: 1rpx; }
.gua-daxiang { font-size: 26rpx; color: var(--ink-deep); margin-top: 8rpx; letter-spacing: 2rpx; line-height: 1.5; }
.gua-guaci { font-size: 26rpx; color: var(--text); margin-top: 10rpx; letter-spacing: 2rpx; line-height: 1.6; text-align: center; }
.c-ti { color: var(--gold); font-size: 24rpx; }

/* 排盘表 */
.biao {
  display: flex; flex-direction: column;
  border-top: 2rpx solid var(--gold);
  border-bottom: 2rpx solid var(--gold);
}
.biao-header, .biao-row {
  display: grid;
  grid-template-columns: 72rpx 84rpx 84rpx 180rpx 48rpx 1fr;
  align-items: center;
  padding: 14rpx 8rpx;
}
.biao-header {
  border-bottom: 1rpx solid var(--tint-40);
  font-size: 24rpx; color: var(--gold); font-weight: bold;
}
.biao-row {
  border-bottom: 1rpx dashed var(--tint-20);
  font-size: 28rpx; color: var(--text);
}
.biao-row:active { background: var(--tint-10); }
.biao-row:last-child { border-bottom: none; }
.biao-row.is-dong { background: var(--rwash-05); }
/* 展开的爻辞原文行 */
.row-ci {
  padding: 14rpx 16rpx 18rpx;
  border-bottom: 1rpx dashed var(--tint-20);
  background: var(--tint-05);
  font-size: 26rpx; color: var(--ink-deep); line-height: 1.7;
}
.biao-hint { margin-top: 10rpx; font-size: 22rpx; color: var(--text-weak); text-align: center; }
.c-shen { color: var(--ink-deep); }
.c-qin { color: var(--text-2); font-weight: bold; }
.c-gz { color: var(--text); }
.c-gz .wx { font-size: 22rpx; color: var(--text-weak); margin-left: 4rpx; }
.c-gz .kong { font-size: 20rpx; color: var(--red); margin-left: 6rpx; border: 1rpx solid var(--red); padding: 0 6rpx; border-radius: 4rpx; }
.c-tag .tag { color: var(--red); font-weight: bold; font-size: 30rpx; }
.c-yao { display: flex; align-items: center; justify-content: center; }
.c-yao .bar.yang { width: 110rpx; height: 12rpx; }
.c-yao .yin { width: 110rpx; height: 12rpx; }
.c-yao .yin .seg { width: 44rpx; height: 12rpx; }
.c-yao .ymark { margin-left: 8rpx; color: var(--red); font-size: 24rpx; font-weight: bold; }

.kong-line { margin-top: 18rpx; font-size: 24rpx; color: var(--text-3); letter-spacing: 1rpx; }
.kong-line text { color: var(--red); }

.bottom-pad { height: 60rpx; }
