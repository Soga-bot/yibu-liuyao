/* pages/bagua/bagua.wxss — 八卦基础（古朴宣纸风，复用 wuxing 范式）
   类名一律 ASCII（WXSS 编译器不接受中文类选择器），中文只进内容 */
.status-bar { width: 100%; }
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}

.topbar {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 8rpx;
}
.back {
  width: 56rpx; height: 56rpx;
  border-radius: 50%;
  background: var(--shadow-1);
  color: var(--text-2); font-size: 38rpx; line-height: 56rpx; text-align: center;
}
.title {
  flex: 1; text-align: center;
  font-size: 38rpx; font-weight: bold; color: var(--text);
  letter-spacing: 8rpx; margin-right: 56rpx;
}

.content { flex: 1; padding: 16rpx 28rpx 0; box-sizing: border-box; }

/* ---------- 卡片 ---------- */
.sec {
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 26rpx 28rpx 22rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.sec-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}
.sec-note {
  margin-top: 16rpx;
  font-size: 23rpx;
  color: var(--text-weak);
  line-height: 1.7;
}
.m-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx dashed var(--tint-15);
}
.m-row:last-of-type { border-bottom: none; }
.m-k { font-size: 28rpx; color: var(--red); font-weight: bold; letter-spacing: 2rpx; }
.m-v { font-size: 25rpx; color: var(--text-2); text-align: right; }

/* ---------- 八卦一览（两列卡片） ---------- */
.bg-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.bg-card {
  width: 48%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid var(--tint-15);
  border-radius: 12rpx;
  background: var(--wash-bg-60);
}
.bg-card:nth-last-child(-n+2) { margin-bottom: 0; }
.bg-lines {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 12rpx;
}
.bg-line { width: 64rpx; height: 10rpx; border-radius: 4rpx; background: var(--text); }
.bg-yin {
  background: none;
  display: flex;
  justify-content: space-between;
}
.bg-yin .h { width: 27rpx; height: 10rpx; border-radius: 4rpx; background: var(--text); }
.bg-name { font-size: 30rpx; color: var(--text); letter-spacing: 2rpx; }
.bg-sub { margin-top: 4rpx; font-size: 22rpx; color: var(--text-weak); }

/* ---------- 先天/后天九宫格 ---------- */
.grid9 {
  display: flex;
  flex-direction: column;
  border: 1rpx solid var(--tint-25);
  border-radius: 12rpx;
  overflow: hidden;
}
.grid9-row {
  display: flex;
}
.g9 {
  position: relative;
  flex: 1;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--tint-15);
  border-bottom: 1rpx solid var(--tint-15);
  background: var(--tab-bg);
}
.grid9-row .g9:nth-child(3n) { border-right: none; }
.grid9-row:last-child .g9 { border-bottom: none; }
.g9-mid { background: var(--tint-10); }
.g9-t { font-size: 34rpx; color: var(--text); line-height: 1.2; }
.g9-f {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--text-weak);
  display: flex;
  align-items: center;
}
.g9-shu {
  position: absolute;
  top: 6rpx; right: 10rpx;
  font-size: 20rpx;
  color: rgba(138,94,21,0.55);
}
.g9-dot {
  display: inline-block;
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
  margin-right: 6rpx;
}
.d-mu { background: #4E7A3A; }
.d-huo { background: var(--red-bian); }
.d-tu { background: #8D6E3F; }
.d-jin { background: #A08850; }
.d-shui { background: #3D5A80; }

.map-legend {
  margin-top: 10rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
  letter-spacing: 2rpx;
}

/* ---------- 取象速查表 ---------- */
.grid-head, .grid-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 8rpx;
}
.grid-head {
  color: var(--text-3);
  font-size: 24rpx;
  border-bottom: 1rpx solid var(--tint-20);
}
.grid-row { border-bottom: 1rpx dashed var(--tint-15); }
.grid-row:last-of-type { border-bottom: none; }
.gh, .gc {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-2);
}
.gc-x { color: var(--red); font-weight: bold; }

/* ---------- 卦象速查入口 ---------- */
.go-suca {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  border: 1rpx solid var(--tint-25);
  border-radius: 10rpx;
  background: var(--wash-bg-75);
  font-size: 26rpx;
  color: var(--text-2);
  letter-spacing: 1rpx;
}
.go-suca-hover { background: var(--rwash-05); }
.go-arrow { font-size: 32rpx; color: var(--text-weak); }

.foot-note {
  margin: 10rpx 0 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}
.bottom-pad { height: 40rpx; }
