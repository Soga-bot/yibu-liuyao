/* pages/mine/mine.wxss — 我的：摇卦历史 + 关于 */
.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-color: var(--bg);
  background-image: radial-gradient(circle at 20% 10%, var(--tint-05) 0, transparent 140rpx),
                    radial-gradient(circle at 85% 85%, var(--rwash-05) 0, transparent 160rpx);
}
/* 顶栏在文档流内（非 fixed）：内容在 scroll-view 里滚，物理上不可能钻到顶栏底下 */
.topbar {
  flex-shrink: 0;
  border-bottom: 1rpx solid var(--tint-30);
}
.topbar-title {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  color: var(--text);
  font-weight: bold;
  letter-spacing: 6rpx;
}
.content { flex: 1; padding: 24rpx 28rpx 0; box-sizing: border-box; }
/* tabbar 让位：实体垫块——scroll-view 自带 padding-bottom 部分机型吞掉，不依赖它 */
.tab-clear { height: calc(170rpx + env(safe-area-inset-bottom)); }

/* ---------- 统计卡 ---------- */
.stat-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, var(--card) 0%, var(--card-2) 100%);
  border: 1rpx solid var(--tint-30);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  box-shadow: 0 4rpx 14rpx var(--shadow-1);
}
.stat-main { display: flex; align-items: center; }
.stat-num {
  font-size: 64rpx;
  color: var(--red);
  font-weight: bold;
  line-height: 1;
}
.stat-txt { display: flex; flex-direction: column; margin-left: 24rpx; }
.stat-label { font-size: 30rpx; color: var(--text); font-weight: bold; letter-spacing: 2rpx; }
.stat-sub { font-size: 22rpx; color: var(--text-weak); margin-top: 8rpx; }
.clear-btn {
  font-size: 24rpx;
  color: var(--gold);
  border: 1rpx solid var(--tint-40);
  border-radius: 30rpx;
  padding: 8rpx 26rpx;
}
.clear-hover { background: var(--tint-10); }

/* ---------- 历史列表 ---------- */
.his-card {
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  margin-top: 20rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}

/* 小卦象：6 爻线（上→下），动爻标红 */
.gx {
  flex: 0 0 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.gx .l-yang { width: 56rpx; height: 7rpx; background: var(--text); border-radius: 2rpx; }
.gx .l-yin { width: 56rpx; height: 7rpx; display: flex; justify-content: space-between; }
.gx .l-yin .s { width: 24rpx; height: 7rpx; background: var(--text); border-radius: 2rpx; }
.gx .l-yang + .l-yang, .gx .l-yang + .l-yin,
.gx .l-yin + .l-yang, .gx .l-yin + .l-yin { margin-top: 7rpx; }
.gx .l-yang.l-dong { background: var(--red); }
.gx .l-yin.l-dong .s { background: var(--red); }

.his-info { flex: 1; margin-left: 26rpx; min-width: 0; }
.h-name-row { display: flex; align-items: baseline; }
.h-name { font-size: 32rpx; color: var(--text); font-weight: bold; letter-spacing: 3rpx; }
/* 「问易」标记：该卦已有 AI 解读，点击回看（catchtap 不冒泡到行点击） */
.h-wen {
  font-size: 20rpx;
  color: var(--red-deep);
  border: 1rpx solid var(--rwash-40);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 14rpx;
  background: var(--rwash-05);
}
.h-gz {
  font-size: 21rpx;
  color: var(--gold);
  border: 1rpx solid var(--tint-40);
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-left: 16rpx;
}
.h-time { display: block; margin-top: 8rpx; font-size: 24rpx; color: var(--text-weak); }
.g-arrow { color: var(--text-weak); font-size: 36rpx; margin-left: 12rpx; }

.hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--text-weak);
}

/* ---------- 空态 ---------- */
.empty {
  margin-top: 90rpx;
  text-align: center;
  color: var(--text-weak);
}
.empty-glyph { display: block; font-size: 120rpx; color: #b07d22; }
.empty-tip { display: block; margin-top: 30rpx; font-size: 32rpx; color: var(--text-2); }
.empty-sub { display: block; margin-top: 16rpx; font-size: 24rpx; }

/* ---------- 关于 ---------- */
.about-card {
  background: var(--tint-05);
  border: 1rpx dashed var(--tint-35);
  border-radius: 16rpx;
  padding: 28rpx 30rpx;
  margin-top: 44rpx;
}
.about-title {
  font-size: 28rpx;
  color: var(--gold);
  font-weight: bold;
  letter-spacing: 3rpx;
}
.about-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.8;
}
.about-ver {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}

/* 历史条目：所问之事（问事签带入，未填不显示） */
.h-qiu {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
  letter-spacing: 1rpx;
}

/* ---------- 设置入口（深色模式/正文字号/背景音乐在独立设置页） ---------- */
.set-card {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  background: var(--card);
  border: 1rpx solid var(--tint-20);
  border-left: 6rpx solid var(--gold-lt);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
  box-shadow: 0 3rpx 12rpx var(--shadow-1);
}
.set-glyph {
  flex: 0 0 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 34rpx;
  color: var(--gold);
  background: var(--tint-10);
  border: 1rpx solid var(--tint-30);
  border-radius: 12rpx;
}
.set-info { flex: 1; margin-left: 24rpx; }
.set-name {
  display: block;
  font-size: 30rpx;
  color: var(--text);
  letter-spacing: 2rpx;
}
.set-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-weak);
}
