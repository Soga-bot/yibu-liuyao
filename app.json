{
  "pages": [
    "pages/index/index",
    "pages/paigua/paigua",
    "pages/dianji/dianji",
    "pages/dianji/detail",
    "pages/mine/mine"
  ],
  "subPackages": [
    {
      "root": "package3d",
      "name": "divination3d",
      "pages": ["pages/ask/ask", "pages/divination/divination", "pages/result/result", "pages/wenyi/wenyi"]
    },
    {
      "root": "packageBooks",
      "name": "books",
      "pages": ["wuxing/wuxing", "bagua/bagua", "bagong/bagong", "paipan/paipan", "dianji/shiyi", "settings/settings"]
    },
    {
      "root": "packageEngine",
      "name": "engine",
      "pages": []
    }
  ],
  "preloadRule": {
    "pages/index/index": { "network": "wifi", "packages": ["packageBooks"] },
    "pages/dianji/dianji": { "network": "wifi", "packages": ["packageBooks"] }
  },
  "window": {
    "navigationBarBackgroundColor": "@navBg",
    "navigationBarTextStyle": "@navTxt",
    "navigationBarTitleText": "易研六爻",
    "navigationStyle": "custom",
    "backgroundColor": "@bg",
    "backgroundTextStyle": "@bgTxt"
  },
  "darkmode": true,
  "themeLocation": "theme.json",
  "requiredBackgroundModes": ["audio"],
  "tabBar": {
    "custom": true,
    "color": "#8a7355",
    "selectedColor": "#c0392b",
    "backgroundColor": "#fffdf6",
    "borderStyle": "white",
    "list": [
      { "pagePath": "pages/index/index", "text": "首页" },
      { "pagePath": "pages/paigua/paigua", "text": "解卦" },
      { "pagePath": "pages/dianji/dianji", "text": "典籍库" },
      { "pagePath": "pages/mine/mine", "text": "我的" }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json"
}
